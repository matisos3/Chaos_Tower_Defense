    private bool HasLegacyTalentPoints(
        GetUserDataResult result)
    {
        return result != null &&
               result.Data != null &&
               result.Data.ContainsKey(
                   PLAYER_TALENT_POINTS_KEY);
    }


    private int LoadLegacyTalentPoints(
        GetUserDataResult result)
    {
        if (!HasLegacyTalentPoints(result))
            return 0;

        UserDataRecord record =
            result.Data[
                PLAYER_TALENT_POINTS_KEY
            ];

        if (record == null)
            return 0;

        if (int.TryParse(
            record.Value,
            out int parsedPoints))
        {
            return Mathf.Max(
                0,
                parsedPoints
            );
        }

        return 0;
    }


    private int LoadLegacyDamageTalentLevel(
        GetUserDataResult result)
    {
        if (result == null ||
            result.Data == null ||
            !result.Data.ContainsKey(
                PLAYER_DAMAGE_TALENT_LEVEL_KEY))
        {
            return 0;
        }

        UserDataRecord record =
            result.Data[
                PLAYER_DAMAGE_TALENT_LEVEL_KEY
            ];

        if (record == null)
            return 0;

        if (int.TryParse(
            record.Value,
            out int parsedLevel))
        {
            return Mathf.Max(
                0,
                parsedLevel
            );
        }

        return 0;
    }


    private void LoadLegacyTalentLevels(
        GetUserDataResult result)
    {
        if (result == null ||
            result.Data == null)
        {
            return;
        }

        const string prefix =
            "Talent_";

        foreach (
            KeyValuePair<string, UserDataRecord> pair
            in result.Data)
        {
            if (!pair.Key.StartsWith(
                prefix,
                StringComparison.Ordinal))
            {
                continue;
            }

            UserDataRecord record =
                pair.Value;

            if (record == null)
                continue;

            string talentID =
                pair.Key.Substring(
                    prefix.Length
                );

            if (string.IsNullOrWhiteSpace(
                talentID))
            {
                continue;
            }

            if (int.TryParse(
                record.Value,
                out int parsedLevel))
            {
                loadedTalentLevels[
                    talentID
                ] =
                    Mathf.Max(
                        0,
                        parsedLevel
                    );
            }
        }
    }


