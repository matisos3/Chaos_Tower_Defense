    public void SaveTalentProgress(
        string talentID,
        int level,
        int newTalentPoints,
        Action<bool> callback = null)
    {
        if (!IsLoggedIn)
        {
            Debug.LogWarning(
                "[PlayFabManager] Nie można zapisać talentu - " +
                "gracz nie jest zalogowany."
            );

            callback?.Invoke(false);
            return;
        }

        if (string.IsNullOrWhiteSpace(
            talentID))
        {
            Debug.LogWarning(
                "[PlayFabManager] Nie można zapisać talentu - " +
                "brak talentID."
            );

            callback?.Invoke(false);
            return;
        }

        level =
            Mathf.Max(
                0,
                level
            );

        newTalentPoints =
            Mathf.Max(
                0,
                newTalentPoints
            );

        // Kopia istniejących danych.
        // Dzięki temu talentów, których nie znamy w aktualnej
        // wersji gry, nie usuniemy przypadkiem z PlayFab.
        Dictionary<string, int> newLevels =
            new Dictionary<string, int>(
                loadedTalentLevels
            );

        newLevels[talentID] =
            level;

        string json =
            CreateTalentProgressJson(
                newTalentPoints,
                newLevels
            );

        Dictionary<string, string> data =
            new Dictionary<string, string>
            {
                {
                    PLAYER_TALENT_PROGRESS_KEY,
                    json
                },

                // Zachowujemy również stary klucz.
                {
                    PLAYER_TALENT_POINTS_KEY,
                    newTalentPoints.ToString()
                }
            };

        PlayFabClientAPI.UpdateUserData(
            new UpdateUserDataRequest
            {
                Data = data
            },
            result =>
            {
                loadedTalentLevels =
                    newLevels;

                TalentPoints =
                    newTalentPoints;

                IsTalentPointsLoaded = true;
                IsTalentProgressLoadedInternal = true;

                callback?.Invoke(true);
            },
            error =>
            {
                Debug.LogError(
                    "[PlayFabManager] Nie udało się zapisać " +
                    "TalentProgress po zakupie talentu " +
                    talentID +
                    ": " +
                    GetPlayFabErrorText(error)
                );

                callback?.Invoke(false);
            }
        );
    }


