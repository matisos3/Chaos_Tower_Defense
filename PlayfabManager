    // =========================================================
    // SAVE LEADERBOARD SCORE
    // =========================================================

    private void SaveLeaderboardScore(
        int highestWave,
        double damageDealt,
        int enemiesKilled)
    {
        if (!IsLoggedIn)
            return;

        if (!IsEntityLoggedIn ||
            !PlayFabSettings.staticPlayer
                .IsEntityLoggedIn())
        {
            pendingLeaderboardSave = true;

            pendingLeaderboardHighestWave =
                highestWave;

            pendingLeaderboardDamage =
                damageDealt;

            pendingLeaderboardEnemiesKilled =
                enemiesKilled;

            Debug.Log(
                "[PlayFabManager] Entity Token nie jest jeszcze " +
                "gotowy. Wynik leaderboardu oczekuje na token."
            );

            return;
        }

        if (string.IsNullOrWhiteSpace(
            leaderboardName))
        {
            Debug.LogError(
                "[PlayFabManager] Nazwa leaderboardu jest pusta."
            );

            return;
        }

        if (string.IsNullOrEmpty(
            PlayFabId))
        {
            Debug.LogError(
                "[PlayFabManager] Brak PlayFabId - " +
                "nie można zapisać leaderboardu."
            );

            return;
        }

        highestWave =
            Mathf.Max(
                0,
                highestWave
            );

        enemiesKilled =
            Mathf.Max(
                0,
                enemiesKilled
            );

        if (double.IsNaN(damageDealt) ||
            double.IsInfinity(damageDealt) ||
            damageDealt < 0.0)
        {
            damageDealt = 0.0;
        }

        long damageScore =
            (long)Math.Round(
                damageDealt,
                MidpointRounding.AwayFromZero
            );

        PlayFabProgressionGetMyEntry(
            currentEntry =>
            {
                if (currentEntry == null)
                {
                    UpdateLeaderboardScore(
                        highestWave,
                        damageScore,
                        enemiesKilled
                    );

                    return;
                }

                int oldWave =
                    currentEntry.highestWave;

                long oldDamage =
                    (long)Math.Round(
                        currentEntry.totalDamage,
                        MidpointRounding.AwayFromZero
                    );

                int oldKills =
                    currentEntry.enemiesKilled;

                bool newScoreIsBetter =
                    IsLeaderboardScoreBetter(
                        highestWave,
                        damageScore,
                        enemiesKilled,
                        oldWave,
                        oldDamage,
                        oldKills
                    );

                if (!newScoreIsBetter)
                {
                    UpdateLeaderboardScore(
                        oldWave,
                        oldDamage,
                        oldKills
                    );

                    return;
                }

                UpdateLeaderboardScore(
                    highestWave,
                    damageScore,
                    enemiesKilled
                );
            }
        );
    }


    private bool IsLeaderboardScoreBetter(
        int newWave,
        long newDamage,
        int newKills,
        int oldWave,
        long oldDamage,
        int oldKills)
    {
        if (newWave > oldWave)
            return true;

        if (newWave < oldWave)
            return false;

        if (newDamage > oldDamage)
            return true;

        if (newDamage < oldDamage)
            return false;

        if (newKills > oldKills)
            return true;

        return false;
    }


    // =========================================================
    // UPDATE LEADERBOARD
    // =========================================================

    private void UpdateLeaderboardScore(
        int highestWave,
        long damageScore,
        int enemiesKilled)
    {
        if (!IsLoggedIn)
            return;

        if (!IsEntityLoggedIn ||
            !PlayFabSettings.staticPlayer
                .IsEntityLoggedIn())
        {
            pendingLeaderboardSave = true;

            pendingLeaderboardHighestWave =
                highestWave;

            pendingLeaderboardDamage =
                damageScore;

            pendingLeaderboardEnemiesKilled =
                enemiesKilled;

            return;
        }

        string leaderboardDisplayName =
            PlayerDisplayName;

        if (string.IsNullOrWhiteSpace(
            leaderboardDisplayName))
        {
            leaderboardDisplayName =
                "Gracz";
        }

        List<ProgressionModels.LeaderboardEntryUpdate>
            entries =
            new List<
                ProgressionModels.LeaderboardEntryUpdate>
            {
                new ProgressionModels.LeaderboardEntryUpdate
                {
                    EntityId =
                        PlayFabId,

                    Metadata =
                        leaderboardDisplayName,

                    Scores =
                        new List<string>
                        {
                            highestWave.ToString(
                                CultureInfo.InvariantCulture
                            ),

                            damageScore.ToString(
                                CultureInfo.InvariantCulture
                            ),

                            enemiesKilled.ToString(
                                CultureInfo.InvariantCulture
                            )
                        }
                }
            };

        ProgressionModels.UpdateLeaderboardEntriesRequest
            request =
            new ProgressionModels
                .UpdateLeaderboardEntriesRequest
            {
                LeaderboardName =
                    leaderboardName,

                Entries =
                    entries
            };

        PlayFabProgressionAPI.UpdateLeaderboardEntries(
            request,
            result =>
            {
                Debug.Log(
                    "[PlayFabManager] Wynik leaderboardu zapisany. " +
                    "Nazwa: " +
                    leaderboardDisplayName
                );
            },
            error =>
            {
                Debug.LogError(
                    "[PlayFabManager] Nie udało się zapisać " +
                    "leaderboardu: " +
                    GetPlayFabErrorText(error)
                );
            }
        );
    }


    // =========================================================
    // POBIERANIE MOJEGO WYNIKU
    // =========================================================

    private void PlayFabProgressionGetMyEntry(
        Action<LeaderboardEntryData> callback)
    {
        if (!IsLoggedIn)
        {
            callback?.Invoke(null);
            return;
        }

        if (!IsEntityLoggedIn ||
            !PlayFabSettings.staticPlayer
                .IsEntityLoggedIn())
        {
            callback?.Invoke(null);
            return;
        }

        if (string.IsNullOrEmpty(
            PlayFabId))
        {
            callback?.Invoke(null);
            return;
        }

        ProgressionModels.GetLeaderboardForEntitiesRequest
            request =
            new ProgressionModels
                .GetLeaderboardForEntitiesRequest
            {
                LeaderboardName =
                    leaderboardName,

                EntityIds =
                    new List<string>
                    {
                        PlayFabId
                    }
            };

        PlayFabProgressionAPI.GetLeaderboardForEntities(
            request,
            result =>
            {
                if (result == null ||
                    result.Rankings == null ||
                    result.Rankings.Count == 0)
                {
                    callback?.Invoke(null);
                    return;
                }

                ProgressionModels.EntityLeaderboardEntry
                    source =
                    result.Rankings[0];

                LeaderboardEntryData converted =
                    ConvertLeaderboardEntry(
                        source
                    );

                callback?.Invoke(
                    converted
                );
            },
            error =>
            {
                Debug.LogWarning(
                    "[PlayFabManager] Nie udało się pobrać " +
                    "aktualnego wyniku leaderboardu: " +
                    GetPlayFabErrorText(error)
                );

                callback?.Invoke(null);
            }
        );
    }


    // =========================================================
    // LEADERBOARD PAGE
    // =========================================================

    public void LoadLeaderboardPage(
        int page,
        Action<LeaderboardPageResult> callback)
    {
        if (!IsLoggedIn)
        {
            callback?.Invoke(
                new LeaderboardPageResult
                {
                    success = false,
                    page = page,
                    errorMessage =
                        "Gracz nie jest zalogowany."
                }
            );

            return;
        }

        if (!IsEntityLoggedIn ||
            !PlayFabSettings.staticPlayer
                .IsEntityLoggedIn())
        {
            callback?.Invoke(
                new LeaderboardPageResult
                {
                    success = false,
                    page = page,
                    entries =
                        new List<
                            LeaderboardEntryData>(),
                    errorMessage =
                        "Entity Token nie jest jeszcze gotowy."
                }
            );

            return;
        }

        page =
            Mathf.Max(
                0,
                page
            );

        uint startingPosition =
            (uint)(
                page *
                LEADERBOARD_PAGE_SIZE +
                1
            );

        ProgressionModels.GetEntityLeaderboardRequest
            request =
            new ProgressionModels
                .GetEntityLeaderboardRequest
            {
                LeaderboardName =
                    leaderboardName,

                PageSize =
                    LEADERBOARD_PAGE_SIZE,

                StartingPosition =
                    startingPosition
            };

        PlayFabProgressionAPI.GetLeaderboard(
            request,
            result =>
            {
                LeaderboardPageResult pageResult =
                    new LeaderboardPageResult
                    {
                        success = true,

                        page = page,

                        totalEntries =
                            result != null
                                ? (int)result.EntryCount
                                : 0,

                        entries =
                            new List<
                                LeaderboardEntryData>()
                    };

                if (result != null &&
                    result.Rankings != null)
                {
                    foreach (
                        ProgressionModels
                            .EntityLeaderboardEntry entry
                        in result.Rankings)
                    {
                        if (entry == null)
                            continue;

                        LeaderboardEntryData converted =
                            ConvertLeaderboardEntry(
                                entry
                            );

                        if (converted != null)
                        {
                            pageResult.entries.Add(
                                converted
                            );
                        }
                    }
                }

                pageResult.totalPages =
                    CalculateTotalLeaderboardPages(
                        pageResult.totalEntries
                    );

                pageResult.hasPreviousPage =
                    page > 0;

                pageResult.hasNextPage =
                    page + 1 <
                    pageResult.totalPages;

                callback?.Invoke(
                    pageResult
                );
            },
            error =>
            {
                callback?.Invoke(
                    new LeaderboardPageResult
                    {
                        success = false,

                        page = page,

                        entries =
                            new List<
                                LeaderboardEntryData>(),

                        errorMessage =
                            GetPlayFabErrorText(
                                error
                            )
                    }
                );
            }
        );
    }


