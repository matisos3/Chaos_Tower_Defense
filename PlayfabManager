    }


    public void SaveGameOverStats(
        int enemiesKilled,
        double damageDealt,
        int highestWave,
        int goldEarned,
        int gameDuration,
        int skillsPurchased,
        int upgradesPurchased,
        Action<bool> callback = null)
    {
        if (enemiesKilled < 0)
            enemiesKilled = 0;

        if (double.IsNaN(damageDealt) ||
            double.IsInfinity(damageDealt) ||
            damageDealt < 0.0)
        {
            damageDealt = 0.0;
        }

        if (highestWave < 0)
            highestWave = 0;

        if (goldEarned < 0)
            goldEarned = 0;

        if (gameDuration < 0)
            gameDuration = 0;

        if (skillsPurchased < 0)
            skillsPurchased = 0;

        if (upgradesPurchased < 0)
            upgradesPurchased = 0;

        if (gameOverStatsSaved)
            BeginNewGameSession();

        string buildSkills = "";
        string buildUpgrades = "";
        string buildSummary = "";

        if (GameStatsManager.Instance != null)
        {
            buildSkills =
                GameStatsManager.Instance
                    .GetPurchasedSkillsSummary();

            buildUpgrades =
                GameStatsManager.Instance
                    .GetPurchasedUpgradesSummary();

            buildSummary =
                GameStatsManager.Instance
                    .GetBuildSummary();
        }

        if (!IsLoggedIn)
        {
            pendingGameOverStats = true;
            pendingGameOverStatsCallback =
                callback;

            pendingEnemiesKilled =
                enemiesKilled;

            pendingDamageDealt =
                damageDealt;

            pendingHighestWave =
                highestWave;

            pendingGoldEarned =
                goldEarned;

            pendingGameDuration =
                gameDuration;

            pendingSkillsPurchased =
                skillsPurchased;

            pendingUpgradesPurchased =
                upgradesPurchased;

            pendingBuildSkills =
                buildSkills;

            pendingBuildUpgrades =
                buildUpgrades;

            pendingBuildSummary =
                buildSummary;

            return;
        }

        SendGameOverStats(
            enemiesKilled,
            damageDealt,
            highestWave,
            goldEarned,
            gameDuration,
            skillsPurchased,
            upgradesPurchased,
            buildSkills,
            buildUpgrades,
            buildSummary,
            callback
        );
    }


    private void SavePendingGameOverStats()
    {
        if (!pendingGameOverStats)
            return;

        SendGameOverStats(
            pendingEnemiesKilled,
            pendingDamageDealt,
            pendingHighestWave,
            pendingGoldEarned,
            pendingGameDuration,
            pendingSkillsPurchased,
            pendingUpgradesPurchased,
            pendingBuildSkills,
            pendingBuildUpgrades,
            pendingBuildSummary,
            pendingGameOverStatsCallback
        );
    }


    private void SendGameOverStats(
        int enemiesKilled,
        double damageDealt,
        int highestWave,
        int goldEarned,
        int gameDuration,
        int skillsPurchased,
        int upgradesPurchased,
        string buildSkills,
        string buildUpgrades,
        string buildSummary,
        Action<bool> callback = null)
    {
        if (!IsLoggedIn)
        {
            callback?.Invoke(false);
            return;
        }

        PlayFabClientAPI.GetPlayerStatistics(
            new GetPlayerStatisticsRequest(),
            result =>
            {
                int previousHighestWave = 0;
                int previousGamesPlayed = 0;
                int previousTotalEnemiesKilled = 0;
                int previousTotalGoldEarned = 0;
                int previousTotalGameTime = 0;
                int previousTotalSkillsPurchased = 0;
                int previousTotalUpgradesPurchased = 0;

                if (result != null &&
                    result.Statistics != null)
                {
                    foreach (
                        StatisticValue statistic
                        in result.Statistics)
                    {
                        if (statistic == null)
                            continue;

                        switch (
                            statistic.StatisticName)
                        {
                            case "HighestWave":
                                previousHighestWave =
                                    Mathf.Max(
                                        0,
                                        statistic.Value
                                    );
                                break;

                            case "GamesPlayed":
                                previousGamesPlayed =
                                    Mathf.Max(
                                        0,
                                        statistic.Value
                                    );
                                break;

                            case "TotalEnemiesKilled":
                                previousTotalEnemiesKilled =
                                    Mathf.Max(
                                        0,
                                        statistic.Value
                                    );
                                break;

                            case "TotalGoldEarned":
                                previousTotalGoldEarned =
                                    Mathf.Max(
                                        0,
                                        statistic.Value
                                    );
                                break;

                            case "TotalGameTime":
                                previousTotalGameTime =
                                    Mathf.Max(
                                        0,
                                        statistic.Value
                                    );
                                break;

                            case "TotalSkillsPurchased":
                                previousTotalSkillsPurchased =
                                    Mathf.Max(
                                        0,
                                        statistic.Value
                                    );
                                break;

                            case "TotalUpgradesPurchased":
                                previousTotalUpgradesPurchased =
                                    Mathf.Max(
                                        0,
                                        statistic.Value
                                    );
                                break;
                        }
                    }
                }

                int newHighestWave =
                    Mathf.Max(
                        previousHighestWave,
                        highestWave
                    );

                int newGamesPlayed =
                    previousGamesPlayed + 1;

                int newTotalEnemiesKilled =
                    previousTotalEnemiesKilled +
                    enemiesKilled;

                int newTotalGoldEarned =
                    previousTotalGoldEarned +
                    goldEarned;

                int newTotalGameTime =
                    previousTotalGameTime +
                    gameDuration;

                int newTotalSkillsPurchased =
                    previousTotalSkillsPurchased +
                    skillsPurchased;

                int newTotalUpgradesPurchased =
                    previousTotalUpgradesPurchased +
                    upgradesPurchased;

                List<PlayFab.ClientModels.StatisticUpdate>
                    statistics =
                    new List<
                        PlayFab.ClientModels.StatisticUpdate>
                    {
                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "EnemiesKilled",

                            Value =
                                enemiesKilled
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "HighestWave",

                            Value =
                                newHighestWave
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "GoldEarned",

                            Value =
                                goldEarned
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "GameDuration",

                            Value =
                                gameDuration
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "GamesPlayed",

                            Value =
                                newGamesPlayed
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "TotalEnemiesKilled",

                            Value =
                                newTotalEnemiesKilled
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "TotalGoldEarned",

                            Value =
                                newTotalGoldEarned
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "TotalGameTime",

                            Value =
                                newTotalGameTime
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "TotalSkillsPurchased",

                            Value =
                                newTotalSkillsPurchased
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "TotalUpgradesPurchased",

                            Value =
                                newTotalUpgradesPurchased
                        }
                    };

                bool isNewHighestWave =
                    highestWave >
                    previousHighestWave;

                PlayFabClientAPI.UpdatePlayerStatistics(
                    new UpdatePlayerStatisticsRequest
                    {
                        Statistics =
                            statistics
                    },
                    updateResult =>
                    {
                        Action<bool> finishSave =
                            success =>
                            {
                                if (!success)
                                {
                                    callback?.Invoke(false);
                                    return;
                                }

                                gameOverStatsSaved =
                                    true;

                                pendingGameOverStats =
                                    false;

                                pendingGameOverStatsCallback =
                                    null;

                                SaveLeaderboardScore(
                                    highestWave,
                                    damageDealt,
                                    enemiesKilled
                                );

                                callback?.Invoke(true);
                            };

                        if (isNewHighestWave)
                        {
                            SaveGameBuildData(
                                damageDealt,
                                buildSkills,
                                buildUpgrades,
                                buildSummary,
                                finishSave
                            );
                        }
                        else
                        {
                            SaveDamageDealt(
                                damageDealt,
                                finishSave
                            );
                        }
                    },
                    error =>
                    {
                        callback?.Invoke(false);
                    }
                );
            },
            error =>
            {
                callback?.Invoke(false);
            }
        );
    }


