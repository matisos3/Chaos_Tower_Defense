            CreateInitialPlayerData();
        else
            LoadPlayerData();

        // Najpierw progresja.
        // Dopiero po jej wczytaniu wczytujemy TalentProgress.
        LoadPlayerProgression();

        CheckGameAccess();

        if (pendingGameOverStats)
            SavePendingGameOverStats();
    }


    // =========================================================
