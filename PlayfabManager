    private void GetEntityToken()
    {
        if (!IsLoggedIn)
        {
            Debug.LogWarning(
                "[PlayFabManager] Nie można pobrać Entity Token - " +
                "brak logowania."
            );

            return;
        }

        authenticationAPI =
            new PlayFabAuthenticationInstanceAPI(
                PlayFabSettings.staticPlayer
            );

        GetEntityTokenRequest request =
            new GetEntityTokenRequest();

        authenticationAPI.GetEntityToken(
            request,
            OnEntityTokenReceived,
            OnEntityTokenFailed
        );
    }


    private void OnEntityTokenReceived(
        GetEntityTokenResponse result)
    {
        if (result == null)
        {
            OnEntityTokenFailed(
                new PlayFabError
                {
                    ErrorMessage =
                        "PlayFab zwrócił pustą odpowiedź Entity Token."
                }
            );

            return;
        }

        if (result.Entity == null)
        {
            OnEntityTokenFailed(
                new PlayFabError
                {
                    ErrorMessage =
                        "PlayFab nie zwrócił EntityKey."
                }
            );

            return;
        }

        if (string.IsNullOrEmpty(
            result.EntityToken))
        {
            OnEntityTokenFailed(
                new PlayFabError
                {
                    ErrorMessage =
                        "PlayFab nie zwrócił EntityToken."
                }
            );

            return;
        }

        EntityToken =
            result.EntityToken;

        EntityId =
            result.Entity.Id;

        EntityType =
            result.Entity.Type;

        PlayFabSettings.staticPlayer.EntityToken =
            result.EntityToken;

        PlayFabSettings.staticPlayer.EntityId =
            result.Entity.Id;

        PlayFabSettings.staticPlayer.EntityType =
            result.Entity.Type;

        IsEntityLoggedIn =
            PlayFabSettings.staticPlayer
                .IsEntityLoggedIn();

        Debug.Log(
            "[PlayFabManager] Entity Token pobrany. " +
            "EntityId: " +
            EntityId +
            ", EntityType: " +
            EntityType +
            ", IsEntityLoggedIn: " +
            IsEntityLoggedIn
        );

        if (pendingLeaderboardSave)
        {
            int wave =
                pendingLeaderboardHighestWave;

            double damage =
                pendingLeaderboardDamage;

            int kills =
                pendingLeaderboardEnemiesKilled;

            pendingLeaderboardSave = false;

            SaveLeaderboardScore(
                wave,
                damage,
                kills
            );
        }
    }


    private void OnEntityTokenFailed(
        PlayFabError error)
    {
        IsEntityLoggedIn = false;

        EntityToken = "";
        EntityId = "";
        EntityType = "";

        Debug.LogError(
            "[PlayFabManager] Nie udało się pobrać " +
            "Entity Token: " +
            GetPlayFabErrorText(error)
        );
    }


