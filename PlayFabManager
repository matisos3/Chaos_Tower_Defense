    // =========================================================
    // XP FLUSH
    // =========================================================

    private void FlushXP(
        Action finished)
    {
        if (!IsLoggedIn ||
            pendingXP <= 0.0)
        {
            finished?.Invoke();
            return;
        }

        double xpToAdd =
            pendingXP;

        PlayFabClientAPI.GetUserData(
            new GetUserDataRequest(),
            result =>
            {
                double serverXP =
                    ReadDoubleUserData(
                        result,
                        PLAYER_XP_KEY,
                        PlayerXP
                    );

                int serverLevel =
                    Mathf.Clamp(
                        ReadIntUserData(
                            result,
                            PLAYER_LEVEL_KEY,
                            startingLevel
                        ),
                        1,
                        maximumLevel
                    );

                double newXP =
                    serverXP +
                    xpToAdd;

                int newLevel =
                    CalculateLevelFromXPForLevel(
                        newXP,
                        serverLevel
                    );

                int levelsGained =
                    Mathf.Max(
                        0,
                        newLevel -
                        serverLevel
                    );

                int newTalentPoints =
                    TalentPoints +
                    levelsGained *
                    TALENT_POINTS_PER_LEVEL;

                int newForgetPoints =
                    ForgetPoints +
                    levelsGained *
                    FORGET_POINTS_PER_PLAYER_LEVEL;

                string talentJson =
                    CreateTalentProgressJson(
                        newTalentPoints,
                        loadedTalentLevels,
                        newForgetPoints
                    );

                Dictionary<string, string> data =
                    new Dictionary<string, string>
                    {
                        {
                            PLAYER_XP_KEY,
                            newXP.ToString(
                                CultureInfo.InvariantCulture
                            )
                        },

                        {
                            PLAYER_LEVEL_KEY,
                            newLevel.ToString()
                        },

                        {
                            PLAYER_TALENT_POINTS_KEY,
                            newTalentPoints.ToString()
                        },

                        {
                            PLAYER_FORGET_POINTS_KEY,
                            newForgetPoints.ToString()
                        },

                        {
                            PLAYER_TALENT_PROGRESS_KEY,
                            talentJson
                        }
                    };

                PlayFabClientAPI.UpdateUserData(
                    new UpdateUserDataRequest
                    {
                        Data =
                            data
                    },
                    saveResult =>
                    {
                        PlayerXP =
                            newXP;

                        PlayerLevel =
                            newLevel;

                        TalentPoints =
                            newTalentPoints;

                        ForgetPoints =
                            newForgetPoints;

                        pendingXP = 0;

                        PersistPendingXP();

                        IsProgressionLoaded =
                            true;

                        IsTalentPointsLoaded =
                            true;

                        IsTalentProgressLoaded =
                            true;

                        ApplyTalentProgressToManager();

                        Debug.Log(
                            "[PlayFabManager] XP zapisane. " +
                            "XP = " +
                            PlayerXP +
                            ", Level = " +
                            PlayerLevel
                        );

                        finished?.Invoke();
                    },
                    error =>
                    {
                        finished?.Invoke();
                    }
                );
            },
            error =>
            {
                finished?.Invoke();
            }
        );
    }

    private int CalculateLevelFromXPForLevel(
        double xp,
        int startingServerLevel)
    {
        int level =
            Mathf.Clamp(
                startingServerLevel,
                1,
                maximumLevel
            );

        while (level < maximumLevel)
        {
            double required =
                GetTotalXPRequiredForLevel(
                    level + 1
                );

            if (xp < required)
                break;

            level++;
        }

        return level;
    }

