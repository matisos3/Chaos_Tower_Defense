    // =========================================================
    // CONVERT LEADERBOARD ENTRY
    // =========================================================

    private LeaderboardEntryData ConvertLeaderboardEntry(
        ProgressionModels.EntityLeaderboardEntry source)
    {
        if (source == null)
            return null;

        int highestWave = 0;
        long totalDamage = 0;
        int enemiesKilled = 0;

        if (source.Scores != null &&
            source.Scores.Count > 0)
        {
            int.TryParse(
                source.Scores[0],
                NumberStyles.Integer,
                CultureInfo.InvariantCulture,
                out highestWave
            );
        }

        if (source.Scores != null &&
            source.Scores.Count > 1)
        {
            long.TryParse(
                source.Scores[1],
                NumberStyles.Integer,
                CultureInfo.InvariantCulture,
                out totalDamage
            );
        }

        if (source.Scores != null &&
            source.Scores.Count > 2)
        {
            int.TryParse(
                source.Scores[2],
                NumberStyles.Integer,
                CultureInfo.InvariantCulture,
                out enemiesKilled
            );
        }

        string displayName =
            source.Metadata;

        if (string.IsNullOrWhiteSpace(
            displayName))
        {
            displayName =
                source.DisplayName;
        }

        string entityId = "";

        if (source.Entity != null)
        {
            entityId =
                source.Entity.Id;
        }

        if (string.IsNullOrWhiteSpace(
            displayName) &&
            !string.IsNullOrWhiteSpace(
                entityId) &&
            string.Equals(
                entityId,
                PlayFabId,
                StringComparison.Ordinal))
        {
            displayName =
                PlayerDisplayName;
        }

        if (string.IsNullOrWhiteSpace(
            displayName))
        {
            displayName =
                "Gracz";
        }

        return new LeaderboardEntryData
        {
            entityId =
                entityId,

            rank =
                source.Rank,

            displayName =
                displayName,

            highestWave =
                Mathf.Max(
                    0,
                    highestWave
                ),

            totalDamage =
                Math.Max(
                    0,
                    totalDamage
                ),

            enemiesKilled =
                Mathf.Max(
                    0,
                    enemiesKilled
                )
        };
    }


    // =========================================================
    // LEADERBOARD PAGES
    // =========================================================

    private int CalculateTotalLeaderboardPages(
        int totalEntries)
    {
        if (totalEntries <= 0)
            return 0;

        return Mathf.CeilToInt(
            totalEntries /
            (float)LEADERBOARD_PAGE_SIZE
        );
    }


    // =========================================================
    // PLAYFAB ERROR
    // =========================================================

    private string GetPlayFabErrorText(
        PlayFabError error)
    {
        if (error == null)
            return "Nieznany błąd PlayFab.";

        if (!string.IsNullOrEmpty(
            error.ErrorMessage))
        {
            return error.ErrorMessage;
        }

        return error.Error.ToString();
    }
