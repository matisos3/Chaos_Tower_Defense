    private void CheckGameAccess()
    {
        if (!IsLoggedIn)
        {
            GameAccessChecked = true;

            IsGameEnabled = true;

            ApplyGameAccessToUI();

            return;
        }

        PlayFabClientAPI.GetTitleData(
            new GetTitleDataRequest
            {
                Keys =
                    new List<string>
                    {
                        GAME_ENABLED_KEY
                    }
            },
            result =>
            {
                GameAccessChecked = true;

                bool enabled = true;

                if (result != null &&
                    result.Data != null &&
                    result.Data.TryGetValue(
                        GAME_ENABLED_KEY,
                        out string value))
                {
                    bool parsed;

                    if (bool.TryParse(
                        value,
                        out parsed))
                    {
                        enabled = parsed;
                    }
                }

                IsGameEnabled =
                    enabled;

                ApplyGameAccessToUI();
            },
            error =>
            {
                GameAccessChecked = true;

                IsGameEnabled = true;

                Debug.LogWarning(
                    "[PlayFabManager] Nie udało się sprawdzić " +
                    "GameEnabled. Gra pozostaje dostępna."
                );

                ApplyGameAccessToUI();
            }
        );
    }

    private void ApplyGameAccessToUI()
    {
        if (gameAccessUI == null)
            return;

        if (IsGameEnabled)
        {
            gameAccessUI.Hide();
        }
        else
        {
            gameAccessUI.Show(
                "Testy zostały zakończone.\n\nDziękuję!"
            );
        }
    }

