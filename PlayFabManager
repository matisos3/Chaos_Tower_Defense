                    GetPlayFabErrorText(error)
                );

                callback?.Invoke(
                    false,
                    null
                );
            }
        );
    }


    // =========================================================
    // LEADERBOARD PAGE
    // =========================================================

    public void LoadLeaderboardPage(
        int page,
        Action<LeaderboardPageResult> callback)
    {
        if (!IsLoggedIn)
        {
            callback?.Invoke(
                new LeaderboardPageResult
                {
                    success = false,
                    page = page,
                    errorMessage =
                        "Gracz nie jest zalogowany."
                }
            );

            return;
        }

        if (!IsEntityLoggedIn ||
            PlayFabSettings.staticPlayer == null ||
            !PlayFabSettings.staticPlayer.IsEntityLoggedIn())
        {
            callback?.Invoke(
                new LeaderboardPageResult
                {
                    success = false,
                    page = page,
                    entries =
                        new List<
                            LeaderboardEntryData>(),
                    errorMessage =
                        "Entity Token nie jest jeszcze gotowy."
                }
            );

            return;
        }

        page =
            Mathf.Max(
                0,
                page
            );

        uint startingPosition =
            (uint)(
                page *
                LEADERBOARD_PAGE_SIZE +
                1
            );

        ProgressionModels.GetEntityLeaderboardRequest
            request =
            new ProgressionModels
                .GetEntityLeaderboardRequest
            {
                LeaderboardName =
                    leaderboardName,

                PageSize =
                    LEADERBOARD_PAGE_SIZE,

                StartingPosition =
                    startingPosition
            };

        PlayFabProgressionAPI.GetLeaderboard(
            request,
            result =>
            {
                LeaderboardPageResult pageResult =
                    new LeaderboardPageResult
                    {
                        success = true,

                        page = page,

                        totalEntries =
                            result != null
                                ? (int)result.EntryCount
                                : 0,

                        entries =
                            new List<
                                LeaderboardEntryData>()
                    };

                if (result != null &&
                    result.Rankings != null)
                {
                    foreach (
                        ProgressionModels
                            .EntityLeaderboardEntry entry
                        in result.Rankings)
                    {
                        if (entry == null)
                            continue;

                        LeaderboardEntryData converted =
                            ConvertLeaderboardEntry(
                                entry
                            );

                        if (converted != null)
                        {
                            pageResult.entries.Add(
                                converted
                            );
                        }
                    }
                }

                pageResult.totalPages =
                    CalculateTotalLeaderboardPages(
                        pageResult.totalEntries
                    );

                pageResult.hasPreviousPage =
                    page > 0;

                pageResult.hasNextPage =
                    page + 1 <
                    pageResult.totalPages;

                callback?.Invoke(
                    pageResult
                );
            },
            error =>
            {
                callback?.Invoke(
                    new LeaderboardPageResult
                    {
                        success = false,

                        page = page,

                        entries =
                            new List<
                                LeaderboardEntryData>(),

                        errorMessage =
                            GetPlayFabErrorText(
                                error
                            )
                    }
                );
            }
        );
    }


    public void LoadLeaderboard(
        Action<LeaderboardPageResult> callback)
    {
        LoadLeaderboardPage(
            0,
            callback
        );
    }


    public void LoadLeaderboardNextPage(
        int currentPage,
        Action<LeaderboardPageResult> callback)
    {
        LoadLeaderboardPage(
            currentPage + 1,
            callback
        );
    }


    public void LoadLeaderboardPreviousPage(
        int currentPage,
        Action<LeaderboardPageResult> callback)
    {
        LoadLeaderboardPage(
            Mathf.Max(
                0,
                currentPage - 1
            ),
            callback
        );
    }


