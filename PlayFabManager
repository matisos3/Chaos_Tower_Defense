                /*
                 * Nadal pozostaje true.
                 */
                IsProgressionLoaded = true;

                Debug.LogWarning(
                    "[PlayFabManager] Nie udało się utworzyć " +
                    "początkowej progresji: " +
                    GetPlayFabErrorText(error)
                );
            }
        );
