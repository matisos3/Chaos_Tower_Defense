    // =========================================================
    // TALENT LOAD
    // =========================================================

    public void LoadTalentProgress()
    {
        if (!IsLoggedIn)
        {
            IsTalentProgressLoaded = true;
            IsTalentPointsLoaded = true;
            return;
        }

        if (talentProgressLoadInProgress)
            return;

        talentProgressLoadInProgress = true;

        PlayFabClientAPI.GetUserData(
            new GetUserDataRequest(),
            OnTalentProgressReceived,
            OnTalentProgressFailed
        );
    }

    private void OnTalentProgressReceived(
        GetUserDataResult result)
    {
        talentProgressLoadInProgress = false;

        loadedTalentLevels.Clear();

        int loadedPoints = 0;
        int loadedForgetPoints = STARTING_FORGET_POINTS;

        bool loadedUnified = false;

        if (result != null &&
            result.Data != null &&
            result.Data.TryGetValue(
                PLAYER_TALENT_PROGRESS_KEY,
                out UserDataRecord record))
        {
            if (record != null &&
                !string.IsNullOrWhiteSpace(record.Value))
            {
                try
                {
                    TalentProgressSaveData saveData =
                        JsonUtility.FromJson<TalentProgressSaveData>(
                            record.Value
                        );

                    if (saveData != null)
                    {
                        loadedPoints =
                            Mathf.Max(
                                0,
                                saveData.talentPoints
                            );

                        loadedForgetPoints =
                            Mathf.Max(
                                0,
                                saveData.forgetPoints
                            );

                        if (result.Data.ContainsKey(
                            PLAYER_FORGET_POINTS_KEY) == false)
                        {
                            loadedForgetPoints =
                                STARTING_FORGET_POINTS;
                        }

                        if (saveData.talents != null)
                        {
                            foreach (
                                TalentLevelSaveData talent
                                in saveData.talents)
                            {
                                if (talent == null)
                                    continue;

                                if (string.IsNullOrWhiteSpace(
                                    talent.talentID))
                                {
                                    continue;
                                }

                                loadedTalentLevels[
                                    talent.talentID
                                ] =
                                    Mathf.Max(
                                        0,
                                        talent.level
                                    );
                            }
                        }

                        loadedUnified = true;
                    }
                }
                catch (Exception e)
                {
                    Debug.LogWarning(
                        "[PlayFabManager] Błąd TalentProgress: " +
                        e.Message
                    );
                }
            }
        }

        if (!loadedUnified)
        {
            loadedPoints =
                ReadIntUserData(
                    result,
                    PLAYER_TALENT_POINTS_KEY,
                    0
                );

            loadedForgetPoints =
                ReadIntUserData(
                    result,
                    PLAYER_FORGET_POINTS_KEY,
                    STARTING_FORGET_POINTS
                );

            int legacyDamage =
                ReadIntUserData(
                    result,
                    PLAYER_DAMAGE_TALENT_LEVEL_KEY,
                    0
                );

            if (legacyDamage > 0)
            {
                loadedTalentLevels[
                    "damage_all"
                ] = legacyDamage;
            }
        }

        TalentPoints = loadedPoints;
        ForgetPoints = loadedForgetPoints;

        IsTalentPointsLoaded = true;
        IsTalentProgressLoaded = true;

        ApplyTalentProgressToManager();

        /*
         * Jeżeli konto było stare, zapisujemy nowy snapshot.
         */
        if (!loadedUnified && IsLoggedIn)
        {
            SaveTalentProgressSnapshot(
                TalentPoints,
                loadedTalentLevels,
                ForgetPoints,
                null
            );
        }
    }

    private void OnTalentProgressFailed(
        PlayFabError error)
    {
        talentProgressLoadInProgress = false;

        /*
         * Nie blokujemy gry.
         */
        IsTalentPointsLoaded = true;
        IsTalentProgressLoaded = true;

        Debug.LogWarning(
            "[PlayFabManager] Nie udało się wczytać talentów: " +
            GetPlayFabErrorText(error)
        );
    }

    private int ReadIntUserData(
        GetUserDataResult result,
        string key,
        int defaultValue)
    {
        if (result == null ||
            result.Data == null)
        {
            return defaultValue;
        }

        if (!result.Data.TryGetValue(
            key,
            out UserDataRecord record))
        {
            return defaultValue;
        }

        if (record == null)
            return defaultValue;

        if (int.TryParse(
            record.Value,
            out int value))
        {
            return value;
        }

        return defaultValue;
    }

    // =========================================================
    // APPLY TALENTS
    // =========================================================

    public void ApplyTalentProgressToManager()
    {
        if (!IsTalentProgressLoaded)
            return;

        if (SkillTalentManager.Instance == null)
            return;

        SkillTalentManager.Instance.ApplyTalentProgress(
            loadedTalentLevels
        );
    }

    // =========================================================
    // SAVE TALENT SNAPSHOT
    // =========================================================

    private string CreateTalentProgressJson(
        int talentPoints,
        Dictionary<string, int> levels,
        int forgetPoints)
    {
        TalentProgressSaveData data =
            new TalentProgressSaveData();

        data.talentPoints =
            Mathf.Max(0, talentPoints);

        data.forgetPoints =
            Mathf.Max(0, forgetPoints);

        if (levels != null)
        {
            foreach (
                KeyValuePair<string, int> pair
                in levels)
            {
                if (string.IsNullOrWhiteSpace(pair.Key))
                    continue;

                data.talents.Add(
                    new TalentLevelSaveData
                    {
                        talentID = pair.Key,
                        level = Mathf.Max(0, pair.Value)
                    }
                );
            }
        }

        return JsonUtility.ToJson(data);
    }

