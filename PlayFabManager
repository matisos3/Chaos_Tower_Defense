    private void StartGameOverRetryCoroutine()
    {
        if (!pendingGameOverStats)
            return;

        StartCoroutine(
            GameOverRetryCoroutine()
        );
    }


    private IEnumerator GameOverRetryCoroutine()
    {
        /*
         * Ten coroutine jest celowo prosty.
         *
         * Jeżeli Game Over nie został zapisany,
         * co kilka sekund sprawdzamy logowanie i ponawiamy.
         */
        while (pendingGameOverStats)
        {
            if (IsLoggedIn &&
                !gameOverSaveInProgress)
            {
                SavePendingGameOverStats();
            }

            yield return new WaitForSecondsRealtime(
                LEADERBOARD_RETRY_INTERVAL
            );
        }
    }


