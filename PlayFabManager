    public void LoadPlayerProfile()
    {
        if (!IsLoggedIn)
        {
            IsProfileLoaded = true;
            return;
        }

        IsProfileLoaded = false;

        PlayFabClientAPI.GetAccountInfo(
            new GetAccountInfoRequest(),
            OnAccountInfoReceived,
            OnAccountInfoFailed
        );
    }

    private void OnAccountInfoReceived(
        GetAccountInfoResult result)
    {
        PlayerDisplayName = "";

        if (result != null &&
            result.AccountInfo != null &&
            result.AccountInfo.TitleInfo != null)
        {
            PlayerDisplayName =
                result.AccountInfo.TitleInfo.DisplayName ?? "";
        }

        PlayFabClientAPI.GetUserData(
            new GetUserDataRequest(),
            OnProfileUserDataReceived,
            OnProfileUserDataFailed
        );
    }

    private void OnAccountInfoFailed(
        PlayFabError error)
    {
        PlayerDisplayName = "";

        LoadProfileUserData();
    }

    private void LoadProfileUserData()
    {
        if (!IsLoggedIn)
        {
            FinishProfileLoading();
            return;
        }

        PlayFabClientAPI.GetUserData(
            new GetUserDataRequest(),
            OnProfileUserDataReceived,
            OnProfileUserDataFailed
        );
    }

    private void OnProfileUserDataReceived(
        GetUserDataResult result)
    {
        PlayerAvatarId = "";

        PlayerNameChangeUsed = false;

        if (result != null &&
            result.Data != null)
        {
            if (result.Data.TryGetValue(
                PLAYER_AVATAR_KEY,
                out UserDataRecord avatar))
            {
                if (avatar != null)
                    PlayerAvatarId =
                        avatar.Value ?? "";
            }

            if (result.Data.TryGetValue(
                PLAYER_NAME_CHANGE_USED_KEY,
                out UserDataRecord nameChange))
            {
                if (nameChange != null)
                {
                    bool value;

                    if (bool.TryParse(
                        nameChange.Value,
                        out value))
                    {
                        PlayerNameChangeUsed =
                            value;
                    }
                }
            }
        }

        FinishProfileLoading();
    }

    private void OnProfileUserDataFailed(
        PlayFabError error)
    {
        PlayerAvatarId = "";

        PlayerNameChangeUsed = false;

        FinishProfileLoading();
    }

    private void FinishProfileLoading()
    {
        IsProfileLoaded = true;

        HasPlayerProfile =
            !string.IsNullOrWhiteSpace(
                PlayerDisplayName
            ) &&
            !string.IsNullOrWhiteSpace(
                PlayerAvatarId
            );
    }

    public bool CanChangePlayerName()
