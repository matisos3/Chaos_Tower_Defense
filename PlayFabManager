    // =========================================================
    // GAME OVER
    // =========================================================

    public void SaveGameOverStats(
        int enemiesKilled,
        double damageDealt,
        int highestWave,
        int goldEarned,
        int gameDuration,
        int skillsPurchased,
        int upgradesPurchased,
        Action<bool> callback = null)
    {
        enemiesKilled =
            Mathf.Max(
                0,
                enemiesKilled
            );

        highestWave =
            Mathf.Max(
                0,
                highestWave
            );

        goldEarned =
            Mathf.Max(
                0,
                goldEarned
            );

        gameDuration =
            Mathf.Max(
                0,
                gameDuration
            );

        skillsPurchased =
            Mathf.Max(
                0,
                skillsPurchased
            );

        upgradesPurchased =
            Mathf.Max(
                0,
                upgradesPurchased
            );

        if (double.IsNaN(damageDealt) ||
            double.IsInfinity(damageDealt) ||
            damageDealt < 0)
        {
            damageDealt = 0;
        }

        string buildSkills = "";
        string buildUpgrades = "";
        string buildSummary = "";

        if (GameStatsManager.Instance != null)
        {
            buildSkills =
                GameStatsManager.Instance
                    .GetPurchasedSkillsSummary();

            buildUpgrades =
                GameStatsManager.Instance
                    .GetPurchasedUpgradesSummary();

            buildSummary =
                GameStatsManager.Instance
                    .GetBuildSummary();
        }

        /*
         * Jeżeli identyczny Game Over już czeka,
         * nie dodajemy go ponownie.
         */
        if (pendingGameOverStats)
        {
            bool same =
                pendingEnemiesKilled == enemiesKilled &&
                Math.Abs(
                    pendingDamageDealt -
                    damageDealt
                ) < 0.000001 &&
                pendingHighestWave == highestWave &&
                pendingGoldEarned == goldEarned &&
                pendingGameDuration == gameDuration &&
                pendingSkillsPurchased == skillsPurchased &&
                pendingUpgradesPurchased == upgradesPurchased;

            if (same)
            {
                /*
                 * Najważniejsze:
                 *
                 * menu NIE czeka na PlayFab.
                 */
                callback?.Invoke(true);

                TryFlushPendingData();

                return;
            }

            Debug.LogWarning(
                "[PlayFabManager] W kolejce znajduje się " +
                "inny Game Over. Nie nadpisuję danych."
            );

            callback?.Invoke(false);
            return;
        }

        pendingGameOverStats = true;

        pendingEnemiesKilled =
            enemiesKilled;

        pendingDamageDealt =
            damageDealt;

        pendingHighestWave =
            highestWave;

        pendingGoldEarned =
            goldEarned;

        pendingGameDuration =
            gameDuration;

        pendingSkillsPurchased =
            skillsPurchased;

        pendingUpgradesPurchased =
            upgradesPurchased;

        pendingBuildSkills =
            buildSkills ?? "";

        pendingBuildUpgrades =
            buildUpgrades ?? "";

        pendingBuildSummary =
            buildSummary ?? "";

        pendingGameOverStatisticsUpdated = false;
        pendingGameOverUserDataUpdated = false;

        PersistPendingData();

        /*
         * OD RAZU pozwalamy GameOverUI przejść dalej.
         *
         * PlayFab zapisuje się w tle.
         */
        callback?.Invoke(true);

        TryFlushPendingData();
    }

    // =========================================================
    // FLUSH
    // =========================================================

    private void TryFlushPendingData()
    {
        if (!IsLoggedIn)
            return;

        if (gameOverSaveInProgress)
            return;

        if (pendingGameOverStats)
        {
            gameOverSaveInProgress = true;

            FlushGameOver(
                () =>
                {
                    gameOverSaveInProgress = false;

                    TryFlushPendingData();
                }
            );

            return;
        }

        if (pendingXP > 0.0)
        {
            gameOverSaveInProgress = true;

            FlushXP(
                () =>
                {
                    gameOverSaveInProgress = false;

                    TryFlushPendingData();
                }
            );
        }
    }

    // =========================================================
    // FLUSH GAME OVER
    // =========================================================

    private void FlushGameOver(
        Action finished)
    {
        if (!IsLoggedIn)
        {
            finished?.Invoke();
            return;
        }

        if (!pendingGameOverStatisticsUpdated)
        {
            UpdateGameOverStatistics(
                success =>
                {
                    if (!success)
                    {
                        /*
                         * Nie kasujemy kolejki.
                         *
                         * Spróbujemy przy kolejnym
                         * logowaniu / powrocie internetu.
                         */
                        finished?.Invoke();
                        return;
                    }

                    pendingGameOverStatisticsUpdated = true;

                    PersistPendingData();

                    FlushGameOverUserData(
                        finished
                    );
                }
            );

            return;
        }

        FlushGameOverUserData(
            finished
        );
    }

    // =========================================================
    // UPDATE STATISTICS
    // =========================================================

    private void UpdateGameOverStatistics(
        Action<bool> callback)
    {
        if (!IsLoggedIn)
        {
            callback?.Invoke(false);
            return;
        }

        PlayFabClientAPI.GetPlayerStatistics(
            new GetPlayerStatisticsRequest(),
            result =>
            {
                int highestWave = 0;
                int gamesPlayed = 0;
                int totalEnemiesKilled = 0;
                int totalGoldEarned = 0;
                int totalGameTime = 0;
                int totalSkillsPurchased = 0;
                int totalUpgradesPurchased = 0;

                if (result != null &&
                    result.Statistics != null)
                {
                    foreach (
                        StatisticValue stat
                        in result.Statistics)
                    {
                        if (stat == null)
                            continue;

                        switch (stat.StatisticName)
                        {
                            case "HighestWave":
                                highestWave =
                                    Mathf.Max(
                                        0,
                                        stat.Value
                                    );
                                break;

                            case "GamesPlayed":
                                gamesPlayed =
                                    Mathf.Max(
                                        0,
                                        stat.Value
                                    );
                                break;

                            case "TotalEnemiesKilled":
                                totalEnemiesKilled =
                                    Mathf.Max(
                                        0,
                                        stat.Value
                                    );
                                break;

                            case "TotalGoldEarned":
                                totalGoldEarned =
                                    Mathf.Max(
                                        0,
                                        stat.Value
                                    );
                                break;

                            case "TotalGameTime":
                                totalGameTime =
                                    Mathf.Max(
                                        0,
                                        stat.Value
                                    );
                                break;

                            case "TotalSkillsPurchased":
                                totalSkillsPurchased =
                                    Mathf.Max(
                                        0,
                                        stat.Value
                                    );
                                break;

                            case "TotalUpgradesPurchased":
                                totalUpgradesPurchased =
                                    Mathf.Max(
                                        0,
                                        stat.Value
                                    );
                                break;
                        }
                    }
                }

                int newHighestWave =
                    Mathf.Max(
                        highestWave,
                        pendingHighestWave
                    );

                List<StatisticUpdate> updates =
                    new List<StatisticUpdate>
                    {
                        new StatisticUpdate
                        {
                            StatisticName =
                                "EnemiesKilled",

                            Value =
                                pendingEnemiesKilled
                        },

                        new StatisticUpdate
                        {
                            StatisticName =
                                "HighestWave",

                            Value =
