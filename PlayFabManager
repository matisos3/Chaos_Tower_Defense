    public void LoadPlayerProgression()
    {
        if (!IsLoggedIn)
        {
            IsProgressionLoaded = true;
            return;
        }

        IsProgressionLoaded = false;

        PlayFabClientAPI.GetUserData(
            new GetUserDataRequest(),
            OnProgressionReceived,
            OnProgressionFailed
        );
    }

    private void OnProgressionReceived(
        GetUserDataResult result)
    {
        PlayerXP =
            ReadDoubleUserData(
                result,
                PLAYER_XP_KEY,
                0.0
            );

        PlayerLevel =
            Mathf.Clamp(
                ReadIntUserData(
                    result,
                    PLAYER_LEVEL_KEY,
                    startingLevel
                ),
                1,
                maximumLevel
            );

        bool hasXP =
            HasUserDataKey(
                result,
                PLAYER_XP_KEY
            );

        bool hasLevel =
            HasUserDataKey(
                result,
                PLAYER_LEVEL_KEY
            );

        IsProgressionLoaded = true;

        if (!hasXP || !hasLevel)
        {
            SaveInitialProgressionData();
        }

        LoadTalentProgress();
    }

    private void OnProgressionFailed(
        PlayFabError error)
    {
        IsProgressionLoaded = true;

        PlayerLevel =
            Mathf.Clamp(
                PlayerLevel <= 0
                    ? startingLevel
                    : PlayerLevel,
                1,
                maximumLevel
            );

        Debug.LogWarning(
            "[PlayFabManager] Nie udało się pobrać progresji: " +
            GetPlayFabErrorText(error) +
            ". Zachowuję lokalną wartość XP: " +
            PlayerXP
        );

        LoadTalentProgress();
    }

    private bool HasUserDataKey(
        GetUserDataResult result,
        string key)
    {
        return
            result != null &&
            result.Data != null &&
            result.Data.ContainsKey(key);
    }

    private double ReadDoubleUserData(
        GetUserDataResult result,
        string key,
        double defaultValue)
    {
        if (result == null ||
            result.Data == null ||
            !result.Data.ContainsKey(key))
        {
            return defaultValue;
        }

        UserDataRecord record =
            result.Data[key];

        if (record == null)
            return defaultValue;

        if (!double.TryParse(
            record.Value,
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out double value))
        {
            return defaultValue;
        }

        if (double.IsNaN(value) ||
            double.IsInfinity(value) ||
            value < 0)
        {
            return defaultValue;
        }

        return value;
    }

    private void SaveInitialProgressionData()
    {
        if (!IsLoggedIn)
            return;

        PlayerXP = 0.0;

        PlayerLevel =
            Mathf.Clamp(
                startingLevel,
                1,
                maximumLevel
            );

        Dictionary<string, string> data =
            new Dictionary<string, string>
            {
                {
                    PLAYER_XP_KEY,
                    "0"
                },

                {
                    PLAYER_LEVEL_KEY,
                    PlayerLevel.ToString()
                }
            };

        PlayFabClientAPI.UpdateUserData(
            new UpdateUserDataRequest
            {
                Data = data
            },
            result =>
            {
                IsProgressionLoaded = true;
            },
            error =>
            {
                IsProgressionLoaded = true;

                Debug.LogWarning(
                    "[PlayFabManager] Nie udało się utworzyć " +
                    "początkowej progresji: " +
                    GetPlayFabErrorText(error)
                );
            }
        );
    }

    // =========================================================
    // XP CALCULATIONS
    // =========================================================

    public double GetXPRequiredForNextLevel()
    {
        if (PlayerLevel >= maximumLevel)
            return 0.0;

        return GetXPRequiredForLevel(
            PlayerLevel
        );
    }

    public double GetXPRequiredForLevel(
        int level)
    {
        level =
            Mathf.Clamp(
                level,
                1,
                maximumLevel
            );

        if (level >= maximumLevel)
            return 0.0;

        if (baseXPToLevel2 <= 0)
            return 0.0;

        if (xpMultiplier <= 0)
            return baseXPToLevel2;

        return baseXPToLevel2 *
               Math.Pow(
                   xpMultiplier,
                   level - 1
               );
    }

    private double GetTotalXPRequiredForLevel(
        int level)
    {
        if (level <= 1)
            return 0.0;

        double total = 0.0;

        for (int i = 1; i < level; i++)
        {
            total +=
                GetXPRequiredForLevel(i);
        }

        return total;
    }

    public double GetXPIntoCurrentLevel()
    {
        if (PlayerLevel >= maximumLevel)
            return 0.0;

        return Math.Max(
            0.0,
            PlayerXP -
            GetTotalXPRequiredForLevel(
                PlayerLevel
            )
        );
    }

    public double GetXPRemainingToNextLevel()
    {
        if (PlayerLevel >= maximumLevel)
            return 0.0;

        double current =
            GetTotalXPRequiredForLevel(
                PlayerLevel
            );

        double next =
            GetTotalXPRequiredForLevel(
                PlayerLevel + 1
            );

        return Math.Max(
            0.0,
            next - PlayerXP
        );
    }

    // =========================================================
    // XP RESULT
    // =========================================================

    [Serializable]
    public class XPResult
    {
        public bool success;

        public double xpGained;

        public double oldXP;

        public double newXP;

        public int oldLevel;

        public int newLevel;

        public int levelsGained;
    }

    // =========================================================
    // ADD XP
    // =========================================================

    public void AddGameOverXP(
        double damageDealt,
        Action<XPResult> callback = null)
    {
        if (double.IsNaN(damageDealt) ||
            double.IsInfinity(damageDealt) ||
            damageDealt < 0)
        {
            damageDealt = 0;
        }

        double oldXP =
            PlayerXP;

        int oldLevel =
            PlayerLevel;

        pendingXP +=
            damageDealt;

        PlayerXP +=
            damageDealt;

        if (double.IsNaN(PlayerXP) ||
            double.IsInfinity(PlayerXP) ||
            PlayerXP < 0)
        {
            PlayerXP = 0;
        }

        PlayerLevel =
            CalculateLevelFromXP(
                PlayerXP
            );

        PersistPendingXP();

        XPResult result =
            new XPResult
            {
                success = true,

                xpGained =
                    damageDealt,

                oldXP =
                    oldXP,

                newXP =
                    PlayerXP,

                oldLevel =
                    oldLevel,

                newLevel =
                    PlayerLevel,

                levelsGained =
                    Mathf.Max(
                        0,
                        PlayerLevel -
                        oldLevel
                    )
            };

        callback?.Invoke(result);

        TryFlushPendingData();
    }

    private XPResult CalculateLocalXPResult(
        double xpGained)
    {
        double oldXP =
            PlayerXP;

        int oldLevel =
            PlayerLevel;

        double newXP =
            PlayerXP +
            xpGained;

        int newLevel =
            CalculateLevelFromXP(
                newXP
            );

        int levels =
            Mathf.Max(
                0,
                newLevel -
                oldLevel
            );

        return new XPResult
        {
            success = true,

            xpGained =
                xpGained,

            oldXP =
                oldXP,

            newXP =
                newXP,

            oldLevel =
                oldLevel,

            newLevel =
                newLevel,

            levelsGained =
                levels
        };
    }

    private int CalculateLevelFromXP(
        double xp)
    {
        int level =
            Mathf.Clamp(
                PlayerLevel,
                1,
                maximumLevel
            );

        while (level < maximumLevel)
        {
            double required =
                GetTotalXPRequiredForLevel(
                    level + 1
                );

            if (xp < required)
                break;

            level++;
        }

        return level;
    }

