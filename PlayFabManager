    public void Login()
    {
        IsLoggedIn = false;

        IsEntityLoggedIn = false;

        PlayFabId = "";

        EntityId = "";
        EntityType = "";
        EntityToken = "";

        IsProfileLoaded = false;
        HasPlayerProfile = false;

        PlayerDisplayName = "";
        PlayerAvatarId = "";
        PlayerNameChangeUsed = false;

        PlayerXP = 0.0;

        PlayerLevel =
            Mathf.Clamp(
                startingLevel,
                1,
                maximumLevel
            );

        TalentPoints = 0;
        ForgetPoints = STARTING_FORGET_POINTS;

        IsTalentPointsLoaded = false;
        IsTalentProgressLoaded = false;
        IsProgressionLoaded = false;

        talentProgressLoadInProgress = false;

        loadedTalentLevels.Clear();

        /*
         * Bardzo ważne:
         *
         * brak PlayFab NIE oznacza:
         *
         * "gra jest zablokowana".
         *
         * Gra może działać offline.
         */
        GameAccessChecked = false;
        IsGameEnabled = true;

        string customId =
            GetOrCreateLocalPlayerId();

        LoginWithCustomIDRequest request =
            new LoginWithCustomIDRequest
            {
                CustomId = customId,
                CreateAccount = true
            };

        PlayFabClientAPI.LoginWithCustomID(
            request,
            OnLoginSuccess,
            OnLoginFailure
        );
    }

    private string GetOrCreateLocalPlayerId()
    {
        const string key =
            "PLAYFAB_LOCAL_PLAYER_ID";

        string id =
            PlayerPrefs.GetString(
                key,
                ""
            );

        if (!string.IsNullOrEmpty(id))
            return id;

        id = Guid.NewGuid().ToString();

        PlayerPrefs.SetString(
            key,
            id
        );

        PlayerPrefs.Save();

        return id;
    }

    // =========================================================
    // LOGIN SUCCESS
    // =========================================================

    private void OnLoginSuccess(LoginResult result)
    {
        IsLoggedIn = true;

        PlayFabId =
            result != null
                ? result.PlayFabId
                : "";

        Debug.Log(
            "[PlayFabManager] Logowanie OK. PlayFabId = " +
            PlayFabId
        );

        GetEntityToken();

        LoadPlayerProfile();
        LoadPlayerProgression();

        CheckGameAccess();

        /*
         * Najważniejsze:
         *
         * pending data nie blokuje sceny.
         *
         * Próba wysłania odbywa się w tle.
         */
        Invoke(
            nameof(TryFlushPendingData),
            0.5f
        );
    }

    // =========================================================
    // LOGIN FAILURE
    // =========================================================

    private void OnLoginFailure(PlayFabError error)
    {
        IsLoggedIn = false;
        IsEntityLoggedIn = false;

        EntityToken = "";
        EntityId = "";
        EntityType = "";

        /*
         * OFFLINE MODE.
         *
         * Wszystkie flagi gotowości ustawiamy tak,
         * aby żaden ekran ładowania nie wisiał
         * w nieskończoność.
         */
        IsProfileLoaded = true;
        IsProgressionLoaded = true;
        IsTalentProgressLoaded = true;
        IsTalentPointsLoaded = true;

        GameAccessChecked = true;
        IsGameEnabled = true;

        PlayerLevel =
            Mathf.Clamp(
                startingLevel,
                1,
                maximumLevel
            );

        Debug.LogWarning(
            "[PlayFabManager] PlayFab niedostępny. " +
            "Gra przechodzi w tryb offline. " +
            GetPlayFabErrorText(error)
        );

        ApplyGameAccessToUI();
    }

    // =========================================================
