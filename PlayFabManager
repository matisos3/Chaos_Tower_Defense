    private void SaveLeaderboardScore(
        int highestWave,
        double damageDealt,
        int enemiesKilled)
    {
        highestWave =
            Mathf.Max(
                0,
                highestWave
            );

        enemiesKilled =
            Mathf.Max(
                0,
                enemiesKilled
            );

        if (double.IsNaN(damageDealt) ||
            double.IsInfinity(damageDealt) ||
            damageDealt < 0)
        {
            damageDealt = 0;
        }

        if (!IsLoggedIn ||
            !IsEntityLoggedIn ||
            !PlayFabSettings.staticPlayer.IsEntityLoggedIn())
        {
            pendingLeaderboardSave = true;

            pendingLeaderboardHighestWave =
                highestWave;

            pendingLeaderboardDamage =
                damageDealt;

            pendingLeaderboardEnemiesKilled =
                enemiesKilled;

            return;
        }

        long damageScore =
            (long)Math.Round(
                damageDealt,
                MidpointRounding.AwayFromZero
            );

        PlayFabProgressionGetMyEntry(
            current =>
            {
                if (current == null)
                {
                    UpdateLeaderboardScore(
                        highestWave,
                        damageScore,
                        enemiesKilled
                    );

                    return;
                }

                long oldDamage =
                    (long)Math.Round(
                        current.totalDamage,
                        MidpointRounding.AwayFromZero
                    );

                bool better =
                    IsLeaderboardScoreBetter(
                        highestWave,
                        damageScore,
                        enemiesKilled,
                        current.highestWave,
                        oldDamage,
                        current.enemiesKilled
                    );

                if (better)
                {
                    UpdateLeaderboardScore(
                        highestWave,
                        damageScore,
                        enemiesKilled
                    );
                }
            }
        );
    }

    private bool IsLeaderboardScoreBetter(
        int newWave,
        long newDamage,
        int newKills,
        int oldWave,
        long oldDamage,
        int oldKills)
    {
        if (newWave != oldWave)
            return newWave > oldWave;

        if (newDamage != oldDamage)
            return newDamage > oldDamage;

        return newKills > oldKills;
    }

    private void UpdateLeaderboardScore(
        int highestWave,
        long damageScore,
        int enemiesKilled)
    {
        if (!IsLoggedIn ||
            !IsEntityLoggedIn)
        {
            pendingLeaderboardSave = true;

            pendingLeaderboardHighestWave =
                highestWave;

            pendingLeaderboardDamage =
                damageScore;

            pendingLeaderboardEnemiesKilled =
                enemiesKilled;

            return;
        }

        string displayName =
            string.IsNullOrWhiteSpace(
                PlayerDisplayName
            )
                ? "Gracz"
                : PlayerDisplayName;

        List<
            ProgressionModels.LeaderboardEntryUpdate>
            entries =
            new List<
                ProgressionModels.LeaderboardEntryUpdate>
            {
                new ProgressionModels.LeaderboardEntryUpdate
                {
                    EntityId =
                        PlayFabId,

                    Metadata =
                        displayName,

                    Scores =
                        new List<string>
                        {
                            highestWave.ToString(
                                CultureInfo.InvariantCulture
                            ),

                            damageScore.ToString(
                                CultureInfo.InvariantCulture
                            ),

                            enemiesKilled.ToString(
                                CultureInfo.InvariantCulture
                            )
                        }
                }
            };

        PlayFabProgressionAPI.UpdateLeaderboardEntries(
            new ProgressionModels.UpdateLeaderboardEntriesRequest
            {
                LeaderboardName =
                    leaderboardName,

                Entries =
                    entries
            },
            result =>
            {
                pendingLeaderboardSave = false;

                Debug.Log(
                    "[PlayFabManager] Leaderboard zapisany."
                );
            },
            error =>
            {
                pendingLeaderboardSave = true;

                pendingLeaderboardHighestWave =
                    highestWave;

                pendingLeaderboardDamage =
                    damageScore;

                pendingLeaderboardEnemiesKilled =
                    enemiesKilled;
            }
        );
    }

    // =========================================================
    // LEADERBOARD - CURRENT ENTRY
    // =========================================================

    private void PlayFabProgressionGetMyEntry(
        Action<LeaderboardEntryData> callback)
    {
        if (!IsLoggedIn ||
            !IsEntityLoggedIn ||
            string.IsNullOrEmpty(PlayFabId))
        {
            callback?.Invoke(null);
            return;
        }

        PlayFabProgressionAPI.GetLeaderboardForEntities(
            new ProgressionModels.GetLeaderboardForEntitiesRequest
            {
                LeaderboardName =
                    leaderboardName,

                EntityIds =
                    new List<string>
                    {
                        PlayFabId
                    }
            },
            result =>
            {
                if (result == null ||
                    result.Rankings == null ||
                    result.Rankings.Count == 0)
                {
                    callback?.Invoke(null);
                    return;
                }

                callback?.Invoke(
                    ConvertLeaderboardEntry(
                        result.Rankings[0]
                    )
                );
            },
            error =>
            {
                callback?.Invoke(null);
            }
        );
    }

    // =========================================================
    // LEADERBOARD PAGE
    // =========================================================

    public void LoadLeaderboardPage(
        int page,
        Action<LeaderboardPageResult> callback)
    {
        if (!IsLoggedIn)
        {
            callback?.Invoke(
                new LeaderboardPageResult
                {
                    success = false,

                    page =
                        page,

                    entries =
                        new List<LeaderboardEntryData>(),

                    errorMessage =
                        "Gracz nie jest zalogowany."
                }
            );

            return;
        }

        if (!IsEntityLoggedIn)
        {
            callback?.Invoke(
                new LeaderboardPageResult
                {
                    success = false,

                    page =
                        page,

                    entries =
                        new List<LeaderboardEntryData>(),

                    errorMessage =
                        "Leaderboard jest chwilowo niedostępny."
                }
            );

            return;
        }

        page =
            Mathf.Max(
                0,
                page
            );

        uint startingPosition =
            (uint)(
                page *
                LEADERBOARD_PAGE_SIZE +
                1
            );

        PlayFabProgressionAPI.GetLeaderboard(
            new ProgressionModels.GetEntityLeaderboardRequest
            {
                LeaderboardName =
                    leaderboardName,

                PageSize =
                    LEADERBOARD_PAGE_SIZE,

                StartingPosition =
                    startingPosition
            },
            result =>
            {
                LeaderboardPageResult pageResult =
                    new LeaderboardPageResult
                    {
                        success = true,

                        page =
                            page,

                        entries =
                            new List<LeaderboardEntryData>()
                    };

                if (result != null)
                {
                    pageResult.totalEntries =
                        (int)result.EntryCount;

                    if (result.Rankings != null)
                    {
                        foreach (
                            ProgressionModels.EntityLeaderboardEntry
                            entry
                            in result.Rankings)
                        {
                            LeaderboardEntryData converted =
                                ConvertLeaderboardEntry(
                                    entry
                                );

                            if (converted != null)
                            {
                                pageResult.entries.Add(
                                    converted
                                );
                            }
                        }
                    }
                }

                pageResult.totalPages =
                    CalculateTotalLeaderboardPages(
                        pageResult.totalEntries
                    );

                pageResult.hasPreviousPage =
                    page > 0;

                pageResult.hasNextPage =
                    page + 1 <
                    pageResult.totalPages;

                callback?.Invoke(
                    pageResult
                );
            },
            error =>
            {
                callback?.Invoke(
                    new LeaderboardPageResult
                    {
                        success = false,

                        page =
                            page,

                        entries =
                            new List<LeaderboardEntryData>(),

                        errorMessage =
                            GetPlayFabErrorText(error)
                    }
                );
            }
        );
    }

    public void LoadLeaderboard(
        Action<LeaderboardPageResult> callback)
    {
        LoadLeaderboardPage(
            0,
            callback
        );
    }

    public void LoadLeaderboardNextPage(
        int currentPage,
        Action<LeaderboardPageResult> callback)
    {
        LoadLeaderboardPage(
            currentPage + 1,
            callback
        );
    }

    public void LoadLeaderboardPreviousPage(
        int currentPage,
        Action<LeaderboardPageResult> callback)
    {
        LoadLeaderboardPage(
            Mathf.Max(
                0,
                currentPage - 1
            ),
            callback
        );
    }

