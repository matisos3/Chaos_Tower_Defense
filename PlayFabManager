    private void OnProgressionReceived(
        GetUserDataResult result)
    {
        PlayerXP =
            ReadDoubleUserData(
                result,
                PLAYER_XP_KEY,
                0.0
            );

        PlayerLevel =
            Mathf.Clamp(
                ReadIntUserData(
                    result,
                    PLAYER_LEVEL_KEY,
                    startingLevel
                ),
                1,
                maximumLevel
            );

        bool hasXP =
            HasUserDataKey(
                result,
                PLAYER_XP_KEY
            );

        bool hasLevel =
            HasUserDataKey(
                result,
                PLAYER_LEVEL_KEY
            );

        IsProgressionLoaded = true;

        if (!hasXP || !hasLevel)
        {
            SaveInitialProgressionData();
        }

        LoadTalentProgress();
    }

    private void OnProgressionFailed(
        PlayFabError error)
    {
        /*
         * Najważniejsze:
         *
         * NIE:
         *
         * IsProgressionLoaded = false
         *
         * bo wtedy UI może wisieć.
         */
        IsProgressionLoaded = true;

        PlayerXP = 0.0;

        PlayerLevel =
            Mathf.Clamp(
                startingLevel,
                1,
                maximumLevel
            );

        Debug.LogWarning(
            "[PlayFabManager] Nie udało się pobrać progresji: " +
            GetPlayFabErrorText(error)
        );

        LoadTalentProgress();
    }

    private bool HasUserDataKey(
        GetUserDataResult result,
        string key)
    {
        return result != null &&
               result.Data != null &&
               result.Data.ContainsKey(key);
    }

    private double ReadDoubleUserData(
        GetUserDataResult result,
        string key,
        double defaultValue)
    {
        if (result == null ||
            result.Data == null ||
            !result.Data.ContainsKey(key))
        {
            return defaultValue;
        }

        UserDataRecord record =
            result.Data[key];

        if (record == null)
            return defaultValue;

        if (!double.TryParse(
            record.Value,
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out double value))
        {
            return defaultValue;
        }

        if (double.IsNaN(value) ||
            double.IsInfinity(value) ||
            value < 0)
        {
            return defaultValue;
        }

        return value;
    }

    private void SaveInitialProgressionData()
    {
        if (!IsLoggedIn)
            return;

        PlayerXP = 0.0;

        PlayerLevel =
