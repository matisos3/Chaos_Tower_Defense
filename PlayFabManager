    private LeaderboardEntryData ConvertLeaderboardEntry(
        ProgressionModels.EntityLeaderboardEntry source)
    {
        if (source == null)
            return null;

        int wave = 0;
        long damage = 0;
        int kills = 0;

        if (source.Scores != null)
        {
            if (source.Scores.Count > 0)
            {
                int.TryParse(
                    source.Scores[0],
                    NumberStyles.Integer,
                    CultureInfo.InvariantCulture,
                    out wave
                );
            }

            if (source.Scores.Count > 1)
            {
                long.TryParse(
                    source.Scores[1],
                    NumberStyles.Integer,
                    CultureInfo.InvariantCulture,
                    out damage
                );
            }

            if (source.Scores.Count > 2)
            {
                int.TryParse(
                    source.Scores[2],
                    NumberStyles.Integer,
                    CultureInfo.InvariantCulture,
                    out kills
                );
            }
        }

        string displayName =
            source.Metadata;

        if (string.IsNullOrWhiteSpace(displayName))
            displayName = source.DisplayName;

        if (string.IsNullOrWhiteSpace(displayName))
            displayName = "Gracz";

        string entityId = "";

        if (source.Entity != null)
            entityId = source.Entity.Id;

        return new LeaderboardEntryData
        {
            entityId =
                entityId,

            rank =
                source.Rank,

            displayName =
                displayName,

            highestWave =
                Mathf.Max(
                    0,
                    wave
                ),

            totalDamage =
                Math.Max(
                    0,
                    damage
                ),

            enemiesKilled =
                Mathf.Max(
                    0,
                    kills
                )
        };
    }

    private int CalculateTotalLeaderboardPages(
        int totalEntries)
    {
        if (totalEntries <= 0)
            return 0;

        return Mathf.CeilToInt(
            totalEntries /
            (float)LEADERBOARD_PAGE_SIZE
        );
    }

