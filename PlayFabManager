    private string GetPlayFabErrorText(
        PlayFabError error)
    {
        if (error == null)
            return "Nieznany błąd PlayFab.";

        if (!string.IsNullOrEmpty(error.ErrorMessage))
            return error.ErrorMessage;

        return error.Error.ToString();
    }
