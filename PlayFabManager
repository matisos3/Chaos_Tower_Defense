    // =========================================================
    // XP CALCULATIONS
    // =========================================================

    public double GetXPRequiredForNextLevel()
    {
        if (PlayerLevel >= maximumLevel)
            return 0.0;

        return GetXPRequiredForLevel(
            PlayerLevel
        );
    }

    public double GetXPRequiredForLevel(
        int level)
    {
        level =
            Mathf.Clamp(
                level,
                1,
                maximumLevel
            );

        if (level >= maximumLevel)
            return 0.0;

        if (baseXPToLevel2 <= 0)
            return 0.0;

        if (xpMultiplier <= 0)
            return baseXPToLevel2;

        return baseXPToLevel2 *
               Math.Pow(
                   xpMultiplier,
                   level - 1
               );
    }

    private double GetTotalXPRequiredForLevel(
        int level)
    {
        if (level <= 1)
            return 0.0;

        double total = 0.0;

        for (int i = 1; i < level; i++)
        {
            total +=
                GetXPRequiredForLevel(i);
        }

        return total;
    }

    public double GetXPIntoCurrentLevel()
    {
        if (PlayerLevel >= maximumLevel)
            return 0.0;

        return Math.Max(
            0.0,
            PlayerXP -
            GetTotalXPRequiredForLevel(PlayerLevel)
        );
    }

    public double GetXPRemainingToNextLevel()
    {
        if (PlayerLevel >= maximumLevel)
            return 0.0;

        double current =
            GetTotalXPRequiredForLevel(
                PlayerLevel
            );

        double next =
            GetTotalXPRequiredForLevel(
                PlayerLevel + 1
            );

        return Math.Max(
            0.0,
            next - PlayerXP
        );
    }

    // =========================================================
    // XP RESULT
    // =========================================================

    [Serializable]
    public class XPResult
    {
        public bool success;
        public double xpGained;
        public double oldXP;
        public double newXP;
        public int oldLevel;
        public int newLevel;
        public int levelsGained;
    }

    // =========================================================
    // ADD XP
    // =========================================================

    public void AddGameOverXP(
        double damageDealt,
        Action<XPResult> callback = null)
    {
        if (double.IsNaN(damageDealt) ||
            double.IsInfinity(damageDealt) ||
            damageDealt < 0)
        {
            damageDealt = 0;
        }

        /*
         * Jeżeli Game Over już czeka,
         * dokładamy XP do tego samego lokalnego
         * zapisu.
         *
         * Dzięki temu SaveGameOverStats i
         * AddGameOverXP nie wykonują dwóch
         * konkurencyjnych UpdateUserData.
         */
        if (pendingGameOverStats)
        {
            pendingXP += damageDealt;

            PersistPendingData();

            XPResult queuedResult =
                CalculateLocalXPResult(
                    damageDealt
                );

            queuedResult.success = true;

            callback?.Invoke(
                queuedResult
            );

            TryFlushPendingData();

            return;
        }

        /*
         * Brak Game Over - trzymamy XP osobno.
         */
        pendingXP += damageDealt;

        PersistPendingXP();

        XPResult result =
            CalculateLocalXPResult(
                damageDealt
            );

        result.success = true;

        callback?.Invoke(result);

        TryFlushPendingData();
    }

    private XPResult CalculateLocalXPResult(
        double xpGained)
    {
        double oldXP = PlayerXP;
        int oldLevel = PlayerLevel;

        double newXP =
            PlayerXP + xpGained;

        int newLevel =
            CalculateLevelFromXP(
                newXP
            );

        int levels =
            Mathf.Max(
                0,
                newLevel - oldLevel
            );

        return new XPResult
        {
            success = true,
            xpGained = xpGained,
            oldXP = oldXP,
            newXP = newXP,
            oldLevel = oldLevel,
            newLevel = newLevel,
            levelsGained = levels
        };
    }

    private int CalculateLevelFromXP(
        double xp)
    {
        int level =
            Mathf.Clamp(
                PlayerLevel,
                1,
                maximumLevel
            );

        while (level < maximumLevel)
        {
            double required =
                GetTotalXPRequiredForLevel(
                    level + 1
                );

            if (xp < required)
                break;

            level++;
        }

        return level;
    }

