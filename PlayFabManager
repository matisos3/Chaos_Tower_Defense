    private void PersistPendingData()
    {
        /*
         * Jedyną rzeczą zapisywaną lokalnie jest XP.
         *
         * Game Over NIE jest zapisywany.
         */
        PersistPendingXP();

        PlayerPrefs.Save();
    }

    private void PersistPendingXP()
    {
        if (pendingXP > 0.0)
        {
            PlayerPrefs.SetString(
                PENDING_XP_KEY,
                pendingXP.ToString(
                    CultureInfo.InvariantCulture
                )
            );
        }
        else
        {
            PlayerPrefs.DeleteKey(
                PENDING_XP_KEY
            );
        }
    }

    private void LoadPendingData()
    {
        string xp =
            PlayerPrefs.GetString(
                PENDING_XP_KEY,
                "0"
            );

        if (!double.TryParse(
            xp,
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out pendingXP))
        {
            pendingXP = 0;
        }

        pendingXP =
            Math.Max(
                0,
                pendingXP
            );
    }

