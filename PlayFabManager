    private void OnApplicationPause(
        bool pauseStatus)
    {
        if (!pauseStatus)
            return;

        /*
         * Przy pauzie zapisujemy wyłącznie XP.
         *
         * Game Over pozostaje tylko w pamięci.
         */
        PersistPendingData();
