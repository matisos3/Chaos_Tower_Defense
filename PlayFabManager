    [Serializable]
    private class TalentProgressSaveData
    {
        public int talentPoints = 0;
        public int forgetPoints = STARTING_FORGET_POINTS;

        public List<TalentLevelSaveData> talents =
            new List<TalentLevelSaveData>();
    }


    [Serializable]
    private class TalentLevelSaveData
    {
        public string talentID;
        public int level;
    }


    // =========================================================
    // TALENTY - LOAD
    // =========================================================

    public void LoadTalentProgress()
    {
        if (!IsLoggedIn)
        {
            IsTalentProgressLoaded = false;
            IsTalentPointsLoaded = false;
            TalentPoints = 0;
            ForgetPoints = STARTING_FORGET_POINTS;
            loadedTalentLevels.Clear();

            return;
        }

        if (talentProgressLoadInProgress)
            return;

        talentProgressLoadInProgress = true;

        IsTalentProgressLoaded = false;
        IsTalentPointsLoaded = false;

        PlayFabClientAPI.GetUserData(
            new GetUserDataRequest(),
            OnTalentProgressDataReceived,
            OnTalentProgressDataFailed
        );
    }


    private void OnTalentProgressDataReceived(
        GetUserDataResult result)
    {
        talentProgressLoadInProgress = false;

        bool loadedUnifiedProgress =
            false;

        loadedTalentLevels.Clear();

        int loadedPoints = 0;
        int loadedForgetPoints = STARTING_FORGET_POINTS;

        if (result != null &&
            result.Data != null &&
            result.Data.ContainsKey(
                PLAYER_TALENT_PROGRESS_KEY))
        {
            UserDataRecord record =
                result.Data[
                    PLAYER_TALENT_PROGRESS_KEY
                ];

            if (record != null &&
                !string.IsNullOrWhiteSpace(
                    record.Value))
            {
                try
                {
                    TalentProgressSaveData saveData =
                        JsonUtility.FromJson<
                            TalentProgressSaveData>(
                            record.Value
                        );

                    if (saveData != null)
                    {
                        loadedPoints =
                            Mathf.Max(
                                0,
                                saveData.talentPoints
                            );

                        loadedForgetPoints =
                            Mathf.Max(
                                0,
                                saveData.forgetPoints
                            );

                        if (result.Data == null ||
                            !result.Data.ContainsKey(
                                PLAYER_FORGET_POINTS_KEY))
                        {
                            loadedForgetPoints =
                                STARTING_FORGET_POINTS;
                        }

                        if (saveData.talents != null)
                        {
                            foreach (
                                TalentLevelSaveData talentData
                                in saveData.talents)
                            {
                                if (talentData == null)
                                    continue;

                                if (string.IsNullOrWhiteSpace(
                                    talentData.talentID))
                                {
                                    continue;
                                }

                                int level =
                                    Mathf.Max(
                                        0,
                                        talentData.level
                                    );

                                loadedTalentLevels[
                                    talentData.talentID
                                ] = level;
                            }
                        }

                        loadedUnifiedProgress = true;
                    }
                }
                catch (Exception exception)
                {
                    Debug.LogError(
                        "[PlayFabManager] Błąd odczytu " +
                        "TalentProgress: " +
                        exception.Message
                    );
                }
            }
        }

        if (!loadedUnifiedProgress)
        {
            loadedPoints =
                LoadLegacyTalentPoints(
                    result
                );

            loadedForgetPoints =
                LoadLegacyForgetPoints(
                    result
                );

            LoadLegacyTalentLevels(
                result
            );

            if (!loadedTalentLevels.ContainsKey(
                "damage_all"))
            {
                int legacyDamageLevel =
                    LoadLegacyDamageTalentLevel(
                        result
                    );

                if (legacyDamageLevel > 0)
                {
                    loadedTalentLevels[
                        "damage_all"
                    ] =
                        legacyDamageLevel;
                }
            }

            bool hadLegacyPoints =
                HasLegacyTalentPoints(
                    result
                );

            if (!hadLegacyPoints)
            {
                int levelsAlreadyEarned =
                    Mathf.Max(
                        0,
                        PlayerLevel -
                        startingLevel
                    );

                loadedPoints =
                    levelsAlreadyEarned *
                    TALENT_POINTS_PER_LEVEL;
            }

            SaveTalentProgressSnapshot(
                loadedPoints,
                loadedTalentLevels,
                loadedForgetPoints,
                success =>
                {
                    FinishTalentProgressLoading(
                        loadedPoints,
                        loadedTalentLevels,
                        loadedForgetPoints
                    );
                }
            );

            return;
        }

        bool needsForgetPointsMigration =
            result == null ||
            result.Data == null ||
            !result.Data.ContainsKey(
                PLAYER_FORGET_POINTS_KEY
            );

        if (needsForgetPointsMigration)
        {
            SaveTalentProgressSnapshot(
                loadedPoints,
                loadedTalentLevels,
                loadedForgetPoints,
                success =>
                {
                    FinishTalentProgressLoading(
                        loadedPoints,
                        loadedTalentLevels,
                        loadedForgetPoints
                    );
                }
            );

            return;
        }

        FinishTalentProgressLoading(
            loadedPoints,
            loadedTalentLevels,
            loadedForgetPoints
        );
    }


    private void OnTalentProgressDataFailed(
        PlayFabError error)
    {
        talentProgressLoadInProgress = false;

        IsTalentProgressLoaded = false;
        IsTalentPointsLoaded = false;

        TalentPoints = 0;
        ForgetPoints = STARTING_FORGET_POINTS;

        loadedTalentLevels.Clear();

        Debug.LogWarning(
            "[PlayFabManager] Nie udało się wczytać " +
            "progresji talentów: " +
            GetPlayFabErrorText(error)
        );
    }


    private void FinishTalentProgressLoading(
        int points,
        Dictionary<string, int> levels,
        int forgetPoints)
    {
        TalentPoints =
            Mathf.Max(
                0,
                points
            );

        ForgetPoints =
            Mathf.Max(
                0,
                forgetPoints
            );

        IsTalentPointsLoaded = true;

        IsTalentProgressLoaded = true;

        ApplyTalentProgressToManager();

        Debug.Log(
            "[PlayFabManager] TalentProgress wczytany. " +
            "Punkty: " +
            TalentPoints +
            ", Punkty Zapomnienia: " +
            ForgetPoints +
            ", liczba zapisanych talentów: " +
            loadedTalentLevels.Count
        );
    }


    // =========================================================
    // APPLY DO SKILL TALENT MANAGER
    // =========================================================

    public void ApplyTalentProgressToManager()
    {
        if (!IsTalentProgressLoaded)
            return;

        if (SkillTalentManager.Instance == null)
        {
            Debug.LogWarning(
                "[PlayFabManager] SkillTalentManager nie istnieje " +
                "podczas przekazywania TalentProgress."
            );

            return;
        }

        SkillTalentManager.Instance.ApplyTalentProgress(
            loadedTalentLevels
        );
    }


    private bool HasLegacyForgetPoints(
        GetUserDataResult result)
    {
        return result != null &&
               result.Data != null &&
               result.Data.ContainsKey(
                   PLAYER_FORGET_POINTS_KEY);
    }


    private int LoadLegacyForgetPoints(
        GetUserDataResult result)
    {
        if (!HasLegacyForgetPoints(result))
            return STARTING_FORGET_POINTS;

        UserDataRecord record =
            result.Data[
                PLAYER_FORGET_POINTS_KEY
            ];

        if (record == null)
            return STARTING_FORGET_POINTS;

        if (int.TryParse(
            record.Value,
            out int parsedPoints))
        {
            return Mathf.Max(
                0,
                parsedPoints
            );
        }

        return STARTING_FORGET_POINTS;
    }


    // =========================================================
    // STARE TALENTY - LOAD
    // =========================================================

    private bool HasLegacyTalentPoints(
        GetUserDataResult result)
    {
        return result != null &&
               result.Data != null &&
               result.Data.ContainsKey(
                   PLAYER_TALENT_POINTS_KEY);
    }


    private int LoadLegacyTalentPoints(
        GetUserDataResult result)
    {
        if (!HasLegacyTalentPoints(result))
            return 0;

        UserDataRecord record =
            result.Data[
                PLAYER_TALENT_POINTS_KEY
            ];

        if (record == null)
            return 0;

        if (int.TryParse(
            record.Value,
            out int parsedPoints))
        {
            return Mathf.Max(
                0,
                parsedPoints
            );
        }

        return 0;
    }


    private int LoadLegacyDamageTalentLevel(
        GetUserDataResult result)
    {
        if (result == null ||
            result.Data == null ||
            !result.Data.ContainsKey(
                PLAYER_DAMAGE_TALENT_LEVEL_KEY))
        {
            return 0;
        }

        UserDataRecord record =
            result.Data[
                PLAYER_DAMAGE_TALENT_LEVEL_KEY
            ];

        if (record == null)
            return 0;

        if (int.TryParse(
            record.Value,
            out int parsedLevel))
        {
            return Mathf.Max(
                0,
                parsedLevel
            );
        }

        return 0;
    }


    private void LoadLegacyTalentLevels(
        GetUserDataResult result)
    {
        if (result == null ||
            result.Data == null)
        {
            return;
        }

        const string prefix =
            "Talent_";

        foreach (
            KeyValuePair<string, UserDataRecord> pair
            in result.Data)
        {
            if (!pair.Key.StartsWith(
                prefix,
                StringComparison.Ordinal))
            {
                continue;
            }

            UserDataRecord record =
                pair.Value;

            if (record == null)
                continue;

            string talentID =
                pair.Key.Substring(
                    prefix.Length
                );

            if (string.IsNullOrWhiteSpace(
                talentID))
            {
                continue;
            }

            if (int.TryParse(
                record.Value,
                out int parsedLevel))
            {
                loadedTalentLevels[
                    talentID
                ] =
                    Mathf.Max(
                        0,
                        parsedLevel
                    );
            }
        }
    }


    // =========================================================
    // TALENTY - SAVE CAŁEGO PROGRESU
    // =========================================================

    private string CreateTalentProgressJson(
        int points,
        Dictionary<string, int> levels,
        int forgetPoints)
    {
        TalentProgressSaveData saveData =
            new TalentProgressSaveData();

        saveData.talentPoints =
            Mathf.Max(
                0,
                points
            );

        saveData.forgetPoints =
            Mathf.Max(
                0,
                forgetPoints
            );

        if (levels != null)
        {
            foreach (
                KeyValuePair<string, int> pair
                in levels)
            {
                if (string.IsNullOrWhiteSpace(
                    pair.Key))
                {
                    continue;
                }

                saveData.talents.Add(
                    new TalentLevelSaveData
                    {
                        talentID =
                            pair.Key,

                        level =
                            Mathf.Max(
                                0,
                                pair.Value
                            )
                    }
                );
            }
        }

        return JsonUtility.ToJson(
            saveData
        );
    }


    private void SaveTalentProgressSnapshot(
        int points,
        Dictionary<string, int> levels,
        int forgetPoints,
        Action<bool> callback = null)
    {
        if (!IsLoggedIn)
        {
            callback?.Invoke(false);
            return;
        }

        points =
            Mathf.Max(
                0,
                points
            );

        forgetPoints =
            Mathf.Max(
                0,
                forgetPoints
            );

        string json =
            CreateTalentProgressJson(
                points,
                levels,
                forgetPoints
            );

        Dictionary<string, string> data =
            new Dictionary<string, string>
            {
                {
                    PLAYER_TALENT_PROGRESS_KEY,
                    json
                },
                {
                    PLAYER_TALENT_POINTS_KEY,
                    points.ToString()
                },
                {
                    PLAYER_FORGET_POINTS_KEY,
                    forgetPoints.ToString()
                }
            };

        PlayFabClientAPI.UpdateUserData(
            new UpdateUserDataRequest
            {
                Data = data
            },
            result =>
            {
                callback?.Invoke(true);
            },
            error =>
            {
                Debug.LogError(
                    "[PlayFabManager] Nie udało się zapisać " +
                    "TalentProgress: " +
                    GetPlayFabErrorText(error)
                );

                callback?.Invoke(false);
            }
        );
    }


