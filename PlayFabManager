    private void OnLoginSuccess(
        LoginResult result)
    {
        IsLoggedIn = true;

        PlayFabId =
            result.PlayFabId;

        Debug.Log(
            "[PlayFabManager] Zalogowano. PlayFabId: " +
            PlayFabId
        );

        GetEntityToken();

        if (result.NewlyCreated)
            CreateInitialPlayerData();
        else
            LoadPlayerData();

        LoadPlayerProgression();

        CheckGameAccess();

        /*
         * Najważniejsze:
         * pending Game Over może pochodzić z poprzedniego
         * uruchomienia aplikacji.
         */
        if (pendingGameOverStats)
        {
            Debug.Log(
                "[PlayFabManager] Wykryto oczekujący Game Over. " +
                "Rozpoczynam próbę zapisu."
            );

            SavePendingGameOverStats();
        }

        StartLeaderboardRetryCoroutine();

        StartGameOverRetryCoroutine();
    }


    // =========================================================
    // ENTITY TOKEN
    // =========================================================

    private void GetEntityToken()
    {
        if (!IsLoggedIn)
        {
            Debug.LogWarning(
                "[PlayFabManager] Nie można pobrać Entity Token - " +
                "brak logowania."
            );

            return;
        }

        if (entityTokenRequestInProgress)
            return;

        if (IsEntityLoggedIn &&
            PlayFabSettings.staticPlayer != null &&
            PlayFabSettings.staticPlayer.IsEntityLoggedIn())
        {
            return;
        }

        entityTokenRequestInProgress = true;

        authenticationAPI =
            new PlayFabAuthenticationInstanceAPI(
                PlayFabSettings.staticPlayer
            );

        GetEntityTokenRequest request =
            new GetEntityTokenRequest();

        authenticationAPI.GetEntityToken(
            request,
            OnEntityTokenReceived,
            OnEntityTokenFailed
        );
    }


    private void OnEntityTokenReceived(
        GetEntityTokenResponse result)
    {
        entityTokenRequestInProgress = false;

        if (result == null)
        {
            OnEntityTokenFailed(
                new PlayFabError
                {
                    ErrorMessage =
                        "PlayFab zwrócił pustą odpowiedź Entity Token."
                }
            );

            return;
        }

        if (result.Entity == null)
        {
            OnEntityTokenFailed(
                new PlayFabError
                {
                    ErrorMessage =
                        "PlayFab nie zwrócił EntityKey."
                }
            );

            return;
        }

        if (string.IsNullOrEmpty(
            result.EntityToken))
        {
            OnEntityTokenFailed(
                new PlayFabError
                {
                    ErrorMessage =
                        "PlayFab nie zwrócił EntityToken."
                }
            );

            return;
        }

        EntityToken =
            result.EntityToken;

        EntityId =
            result.Entity.Id;

        EntityType =
            result.Entity.Type;

        PlayFabSettings.staticPlayer.EntityToken =
            result.EntityToken;

        PlayFabSettings.staticPlayer.EntityId =
            result.Entity.Id;

        PlayFabSettings.staticPlayer.EntityType =
            result.Entity.Type;

        IsEntityLoggedIn =
            PlayFabSettings.staticPlayer
                .IsEntityLoggedIn();

        Debug.Log(
            "[PlayFabManager] Entity Token pobrany. " +
            "EntityId: " +
            EntityId +
            ", EntityType: " +
            EntityType +
            ", IsEntityLoggedIn: " +
            IsEntityLoggedIn
        );

        if (pendingLeaderboardSave)
        {
            StartLeaderboardRetryCoroutine();

            if (!leaderboardSaveInProgress)
                TryProcessPendingLeaderboardSave();
        }
    }


    private void OnEntityTokenFailed(
        PlayFabError error)
    {
        entityTokenRequestInProgress = false;

        IsEntityLoggedIn = false;

        EntityToken = "";
        EntityId = "";
        EntityType = "";

        Debug.LogError(
            "[PlayFabManager] Nie udało się pobrać " +
            "Entity Token: " +
            GetPlayFabErrorText(error)
        );

        StartLeaderboardRetryCoroutine();
    }


