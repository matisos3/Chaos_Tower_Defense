    public void Login()
    {
        IsLoggedIn = false;

        IsEntityLoggedIn = false;

        PlayFabId = "";

        EntityId = "";
        EntityType = "";
        EntityToken = "";

        IsProfileLoaded = false;
        HasPlayerProfile = false;

        PlayerDisplayName = "";
        PlayerAvatarId = "";
        PlayerNameChangeUsed = false;

        PlayerXP = 0.0;

        PlayerLevel =
            Mathf.Clamp(
                startingLevel,
                1,
                maximumLevel
            );

        TalentPoints = 0;

        ForgetPoints =
            STARTING_FORGET_POINTS;

        IsTalentPointsLoaded = false;

        IsTalentProgressLoaded = false;

        IsProgressionLoaded = false;

        talentProgressLoadInProgress = false;

        loadedTalentLevels.Clear();

        GameAccessChecked = false;

        IsGameEnabled = true;

        string customId =
            GetOrCreateLocalPlayerId();

        LoginWithCustomIDRequest request =
            new LoginWithCustomIDRequest
            {
                CustomId = customId,
                CreateAccount = true
            };

        PlayFabClientAPI.LoginWithCustomID(
            request,
            OnLoginSuccess,
            OnLoginFailure
        );
    }

    private string GetOrCreateLocalPlayerId()
    {
        const string key =
            "PLAYFAB_LOCAL_PLAYER_ID";

        string id =
            PlayerPrefs.GetString(
                key,
                ""
            );

        if (!string.IsNullOrEmpty(id))
            return id;

        id =
            Guid.NewGuid().ToString();

        PlayerPrefs.SetString(
            key,
            id
        );

        PlayerPrefs.Save();

        return id;
    }

    // =========================================================
    // LOGIN SUCCESS
    // =========================================================

    private void OnLoginSuccess(
        LoginResult result)
    {
        IsLoggedIn = true;

        PlayFabId =
            result != null
                ? result.PlayFabId
                : "";

        Debug.Log(
            "[PlayFabManager] Logowanie OK. PlayFabId = " +
            PlayFabId
        );

        GetEntityToken();

        LoadPlayerProfile();

        LoadPlayerProgression();

        CheckGameAccess();

        Invoke(
            nameof(TryFlushPendingData),
            0.5f
        );
    }

    // =========================================================
    // LOGIN FAILURE
    // =========================================================

    private void OnLoginFailure(
        PlayFabError error)
    {
        IsLoggedIn = false;

        IsEntityLoggedIn = false;

        EntityToken = "";
        EntityId = "";
        EntityType = "";

        IsProfileLoaded = true;

        IsProgressionLoaded = true;

        IsTalentProgressLoaded = true;

        IsTalentPointsLoaded = true;

        GameAccessChecked = true;

        IsGameEnabled = true;

        PlayerLevel =
            Mathf.Clamp(
                startingLevel,
                1,
                maximumLevel
            );

        Debug.LogWarning(
            "[PlayFabManager] PlayFab niedostępny. " +
            "Gra przechodzi w tryb offline. " +
            GetPlayFabErrorText(error)
        );

        ApplyGameAccessToUI();
    }

    // =========================================================
    // ENTITY TOKEN
    // =========================================================

    private void GetEntityToken()
    {
        if (!IsLoggedIn)
            return;

        authenticationAPI =
            new PlayFabAuthenticationInstanceAPI(
                PlayFabSettings.staticPlayer
            );

        authenticationAPI.GetEntityToken(
            new GetEntityTokenRequest(),
            OnEntityTokenReceived,
            OnEntityTokenFailed
        );
    }

    private void OnEntityTokenReceived(
        GetEntityTokenResponse result)
    {
        if (result == null ||
            result.Entity == null ||
            string.IsNullOrEmpty(result.EntityToken))
        {
            OnEntityTokenFailed(
                new PlayFabError
                {
                    ErrorMessage =
                        "Brak Entity Token."
                }
            );

            return;
        }

        EntityToken =
            result.EntityToken;

        EntityId =
            result.Entity.Id;

        EntityType =
            result.Entity.Type;

        PlayFabSettings.staticPlayer.EntityToken =
            EntityToken;

        PlayFabSettings.staticPlayer.EntityId =
            EntityId;

        PlayFabSettings.staticPlayer.EntityType =
            EntityType;

        IsEntityLoggedIn =
            PlayFabSettings.staticPlayer.IsEntityLoggedIn();

        Debug.Log(
            "[PlayFabManager] Entity Token OK."
        );

        if (pendingLeaderboardSave)
        {
            int wave =
                pendingLeaderboardHighestWave;

            double damage =
                pendingLeaderboardDamage;

            int kills =
                pendingLeaderboardEnemiesKilled;

            pendingLeaderboardSave = false;

            SaveLeaderboardScore(
                wave,
                damage,
                kills
            );
        }

        TryFlushPendingData();
    }

    private void OnEntityTokenFailed(
        PlayFabError error)
    {
        IsEntityLoggedIn = false;

        EntityToken = "";
        EntityId = "";
        EntityType = "";

        Debug.LogWarning(
            "[PlayFabManager] Entity Token niedostępny: " +
            GetPlayFabErrorText(error)
        );
    }

