    // =========================================================
    // LEADERBOARD - PENDING SAVE
    // =========================================================

    private void LoadPendingLeaderboardSave()
    {
        bool hasPending =
            PlayerPrefs.GetInt(
                PENDING_LEADERBOARD_SAVE_KEY,
                0
            ) == 1;

        if (!hasPending)
        {
            pendingLeaderboardSave = false;
            pendingLeaderboardHighestWave = 0;
            pendingLeaderboardDamage = 0.0;
            pendingLeaderboardEnemiesKilled = 0;

            return;
        }

        pendingLeaderboardSave = true;

        pendingLeaderboardHighestWave =
            Mathf.Max(
                0,
                PlayerPrefs.GetInt(
                    PENDING_LEADERBOARD_WAVE_KEY,
                    0
                )
            );

        string damageString =
            PlayerPrefs.GetString(
                PENDING_LEADERBOARD_DAMAGE_KEY,
                "0"
            );

        if (!double.TryParse(
            damageString,
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out pendingLeaderboardDamage))
        {
            pendingLeaderboardDamage = 0.0;
        }

        if (double.IsNaN(
            pendingLeaderboardDamage) ||
            double.IsInfinity(
                pendingLeaderboardDamage) ||
            pendingLeaderboardDamage < 0.0)
        {
            pendingLeaderboardDamage = 0.0;
        }

        pendingLeaderboardEnemiesKilled =
            Mathf.Max(
                0,
                PlayerPrefs.GetInt(
                    PENDING_LEADERBOARD_KILLS_KEY,
                    0
                )
            );

        Debug.Log(
            "[PlayFabManager] Wczytano oczekujący leaderboard. " +
            "Wave: " +
            pendingLeaderboardHighestWave +
            ", Damage: " +
            pendingLeaderboardDamage +
            ", Kills: " +
            pendingLeaderboardEnemiesKilled
        );
    }


    private void SavePendingLeaderboardToPlayerPrefs()
    {
        if (!pendingLeaderboardSave)
        {
            PlayerPrefs.DeleteKey(
                PENDING_LEADERBOARD_SAVE_KEY
            );

            PlayerPrefs.DeleteKey(
                PENDING_LEADERBOARD_WAVE_KEY
            );

            PlayerPrefs.DeleteKey(
                PENDING_LEADERBOARD_DAMAGE_KEY
            );

            PlayerPrefs.DeleteKey(
                PENDING_LEADERBOARD_KILLS_KEY
            );

            PlayerPrefs.Save();

            return;
        }

        PlayerPrefs.SetInt(
            PENDING_LEADERBOARD_SAVE_KEY,
            1
        );

        PlayerPrefs.SetInt(
            PENDING_LEADERBOARD_WAVE_KEY,
            Mathf.Max(
                0,
                pendingLeaderboardHighestWave
            )
        );

        PlayerPrefs.SetString(
            PENDING_LEADERBOARD_DAMAGE_KEY,
            Math.Max(
                0.0,
                pendingLeaderboardDamage
            ).ToString(
                CultureInfo.InvariantCulture
            )
        );

        PlayerPrefs.SetInt(
            PENDING_LEADERBOARD_KILLS_KEY,
            Mathf.Max(
                0,
                pendingLeaderboardEnemiesKilled
            )
        );

        PlayerPrefs.Save();
    }


    private void SetPendingLeaderboardSave(
        int highestWave,
        double damageDealt,
        int enemiesKilled)
    {
        highestWave =
            Mathf.Max(
                0,
                highestWave
            );

        enemiesKilled =
            Mathf.Max(
                0,
                enemiesKilled
            );

        if (double.IsNaN(damageDealt) ||
            double.IsInfinity(damageDealt) ||
            damageDealt < 0.0)
        {
            damageDealt = 0.0;
        }

        if (pendingLeaderboardSave)
        {
            bool newScoreIsBetter =
                IsLeaderboardScoreBetter(
                    highestWave,
                    damageDealt,
                    enemiesKilled,
                    pendingLeaderboardHighestWave,
                    pendingLeaderboardDamage,
                    pendingLeaderboardEnemiesKilled
                );

            if (!newScoreIsBetter)
            {
                SavePendingLeaderboardToPlayerPrefs();
                return;
            }
        }

        pendingLeaderboardSave = true;

        pendingLeaderboardHighestWave =
            highestWave;

        pendingLeaderboardDamage =
            damageDealt;

        pendingLeaderboardEnemiesKilled =
            enemiesKilled;

        SavePendingLeaderboardToPlayerPrefs();

        Debug.Log(
            "[PlayFabManager] Ustawiono oczekujący leaderboard. " +
            "Wave: " +
            highestWave +
            ", Damage: " +
            damageDealt +
            ", Kills: " +
            enemiesKilled
        );

        StartLeaderboardRetryCoroutine();
    }


    private void ClearPendingLeaderboardSave()
    {
        pendingLeaderboardSave = false;

        pendingLeaderboardHighestWave = 0;
        pendingLeaderboardDamage = 0.0;
        pendingLeaderboardEnemiesKilled = 0;

        PlayerPrefs.DeleteKey(
            PENDING_LEADERBOARD_SAVE_KEY
        );

        PlayerPrefs.DeleteKey(
            PENDING_LEADERBOARD_WAVE_KEY
        );

        PlayerPrefs.DeleteKey(
            PENDING_LEADERBOARD_DAMAGE_KEY
        );

        PlayerPrefs.DeleteKey(
            PENDING_LEADERBOARD_KILLS_KEY
        );

        PlayerPrefs.Save();

        Debug.Log(
            "[PlayFabManager] Oczekujący leaderboard został " +
            "potwierdzony przez PlayFab i usunięty lokalnie."
        );
    }


    private void StartLeaderboardRetryCoroutine()
    {
        if (!pendingLeaderboardSave)
            return;

        if (leaderboardRetryCoroutine != null)
            return;

        leaderboardRetryCoroutine =
            StartCoroutine(
                LeaderboardRetryCoroutine()
            );
    }


    private IEnumerator LeaderboardRetryCoroutine()
    {
        while (pendingLeaderboardSave)
        {
            if (IsLoggedIn &&
                !IsEntityLoggedIn &&
                !entityTokenRequestInProgress)
            {
                GetEntityToken();
            }

            if (IsLoggedIn &&
                IsEntityLoggedIn &&
                PlayFabSettings.staticPlayer != null &&
                PlayFabSettings.staticPlayer.IsEntityLoggedIn() &&
                !leaderboardSaveInProgress)
            {
                TryProcessPendingLeaderboardSave();
            }

            yield return new WaitForSecondsRealtime(
                LEADERBOARD_RETRY_INTERVAL
            );
        }

        leaderboardRetryCoroutine = null;
    }


    private void TryProcessPendingLeaderboardSave()
    {
        if (!pendingLeaderboardSave)
            return;

        if (!IsLoggedIn)
            return;

        if (!IsEntityLoggedIn ||
            PlayFabSettings.staticPlayer == null ||
            !PlayFabSettings.staticPlayer.IsEntityLoggedIn())
        {
            return;
        }

        if (leaderboardSaveInProgress)
            return;

        if (string.IsNullOrWhiteSpace(
            leaderboardName))
        {
            Debug.LogError(
                "[PlayFabManager] Nazwa leaderboardu jest pusta."
            );

            return;
        }

        if (string.IsNullOrEmpty(
            PlayFabId))
        {
            Debug.LogError(
                "[PlayFabManager] Brak PlayFabId - " +
                "nie można zapisać leaderboardu."
            );

            return;
        }

        leaderboardSaveInProgress = true;

        ProcessLeaderboardSave(
            pendingLeaderboardHighestWave,
            pendingLeaderboardDamage,
            pendingLeaderboardEnemiesKilled
        );
    }


