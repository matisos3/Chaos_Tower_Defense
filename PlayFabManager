    public void LoadMyLeaderboardEntry(
        Action<MyLeaderboardResult> callback)
    {
        if (!IsLoggedIn ||
            !IsEntityLoggedIn ||
            string.IsNullOrEmpty(PlayFabId))
        {
            callback?.Invoke(
                new MyLeaderboardResult
                {
                    success = false,

                    hasEntry = false,

                    entry = null,

                    errorMessage =
                        "Leaderboard jest chwilowo niedostępny."
                }
            );

            return;
        }

        PlayFabProgressionAPI.GetLeaderboardForEntities(
            new ProgressionModels.GetLeaderboardForEntitiesRequest
            {
                LeaderboardName =
                    leaderboardName,

                EntityIds =
                    new List<string>
                    {
                        PlayFabId
                    }
            },
            result =>
            {
                if (result == null ||
                    result.Rankings == null ||
                    result.Rankings.Count == 0)
                {
                    callback?.Invoke(
                        new MyLeaderboardResult
                        {
                            success = true,

                            hasEntry = false,

                            entry = null
                        }
                    );

                    return;
                }

                LeaderboardEntryData entry =
                    ConvertLeaderboardEntry(
                        result.Rankings[0]
                    );

                callback?.Invoke(
                    new MyLeaderboardResult
                    {
                        success = true,

                        hasEntry =
                            entry != null,

                        entry =
                            entry
                    }
                );
            },
            error =>
            {
                callback?.Invoke(
                    new MyLeaderboardResult
                    {
                        success = false,

                        hasEntry = false,

                        entry = null,

                        errorMessage =
                            GetPlayFabErrorText(error)
                    }
                );
            }
        );
    }

    // =========================================================
    // LEADERBOARD MODELS
    // =========================================================

    [Serializable]
    public class LeaderboardEntryData
    {
        public string entityId;

        public int rank;

        public string displayName;

        public int highestWave;

        public double totalDamage;

        public int enemiesKilled;
    }

    [Serializable]
    public class LeaderboardPageResult
    {
        public bool success;

        public int page;

        public int totalEntries;

        public int totalPages;

        public bool hasPreviousPage;

        public bool hasNextPage;

        public List<LeaderboardEntryData> entries =
            new List<LeaderboardEntryData>();

        public string errorMessage;
    }

    [Serializable]
    public class MyLeaderboardResult
    {
        public bool success;

        public bool hasEntry;

        public LeaderboardEntryData entry;

        public string errorMessage;
    }

    private LeaderboardEntryData ConvertLeaderboardEntry(
        ProgressionModels.EntityLeaderboardEntry source)
    {
        if (source == null)
            return null;

        int wave = 0;

        long damage = 0;

        int kills = 0;

        if (source.Scores != null)
        {
            if (source.Scores.Count > 0)
            {
                int.TryParse(
                    source.Scores[0],
                    NumberStyles.Integer,
                    CultureInfo.InvariantCulture,
                    out wave
                );
            }

            if (source.Scores.Count > 1)
            {
                long.TryParse(
                    source.Scores[1],
                    NumberStyles.Integer,
                    CultureInfo.InvariantCulture,
                    out damage
                );
            }

            if (source.Scores.Count > 2)
            {
                int.TryParse(
                    source.Scores[2],
                    NumberStyles.Integer,
                    CultureInfo.InvariantCulture,
                    out kills
                );
            }
        }

        string displayName =
            source.Metadata;

        if (string.IsNullOrWhiteSpace(
            displayName))
        {
            displayName =
                source.DisplayName;
        }

        if (string.IsNullOrWhiteSpace(
            displayName))
        {
            displayName = "Gracz";
        }

        string entityId = "";

        if (source.Entity != null)
            entityId =
                source.Entity.Id;

        return new LeaderboardEntryData
        {
            entityId =
                entityId,

            rank =
                source.Rank,

            displayName =
                displayName,

            highestWave =
                Mathf.Max(
                    0,
                    wave
                ),

            totalDamage =
                Math.Max(
                    0,
                    damage
                ),

            enemiesKilled =
                Mathf.Max(
                    0,
                    kills
                )
        };
    }

    private int CalculateTotalLeaderboardPages(
        int totalEntries)
    {
        if (totalEntries <= 0)
            return 0;

        return Mathf.CeilToInt(
            totalEntries /
            (float)LEADERBOARD_PAGE_SIZE
        );
    }

    // =========================================================
    // PLAYFAB ERROR
    // =========================================================

    private string GetPlayFabErrorText(
        PlayFabError error)
    {
        if (error == null)
            return "Nieznany błąd PlayFab.";

        if (!string.IsNullOrEmpty(
            error.ErrorMessage))
        {
            return error.ErrorMessage;
        }

        return error.Error.ToString();
    }
