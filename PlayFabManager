                    PlayerPrefs.GetInt(
                        PENDING_GAMEOVER_UPGRADES_KEY,
                        0
                    )
                );

            pendingBuildSkills =
                PlayerPrefs.GetString(
                    PENDING_GAMEOVER_BUILD_SKILLS_KEY,
                    ""
                );

            pendingBuildUpgrades =
                PlayerPrefs.GetString(
                    PENDING_GAMEOVER_BUILD_UPGRADES_KEY,
                    ""
                );

            pendingBuildSummary =
                PlayerPrefs.GetString(
                    PENDING_GAMEOVER_BUILD_SUMMARY_KEY,
                    ""
                );

            pendingGameOverStatisticsUpdated =
                PlayerPrefs.GetInt(
                    PENDING_GAMEOVER_STATS_UPDATED_KEY,
                    0
                ) == 1;

            pendingGameOverUserDataUpdated =
                PlayerPrefs.GetInt(
                    PENDING_GAMEOVER_USERDATA_UPDATED_KEY,
                    0
                ) == 1;
        }

        string xp =
            PlayerPrefs.GetString(
                PENDING_XP_KEY,
                "0"
            );

        if (!double.TryParse(
            xp,
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out pendingXP))
        {
            pendingXP = 0;
        }

        pendingXP =
            Math.Max(
                0,
                pendingXP
            );

        if (pendingGameOverStats)
        {
            Debug.Log(
                "[PlayFabManager] Znaleziono oczekujący Game Over."
