    public void Login()
    {
        IsLoggedIn = false;

        IsEntityLoggedIn = false;
        EntityId = "";
        EntityType = "";
        EntityToken = "";

        entityTokenRequestInProgress = false;

        GameAccessChecked = false;
        IsGameEnabled = false;

        IsProfileLoaded = false;
        HasPlayerProfile = false;

        IsProgressionLoaded = false;

        PlayerDisplayName = "";
        PlayerAvatarId = "";
        PlayerNameChangeUsed = false;

        PlayerXP = 0.0;

        PlayerLevel =
            Mathf.Max(
                1,
                startingLevel
            );

        TalentPoints = 0;
        ForgetPoints = STARTING_FORGET_POINTS;

        IsTalentPointsLoaded = false;
        IsTalentProgressLoaded = false;

        talentProgressLoadInProgress = false;

        loadedTalentLevels.Clear();

        /*
         * Nie kasujemy pendingów.
         *
         * Jeżeli dane oczekują z poprzedniej sesji,
         * muszą zostać zachowane.
         */
        LoadPendingLeaderboardSave();
        LoadPendingGameOverSave();

        string customId =
            GetOrCreateLocalPlayerId();

        LoginWithCustomIDRequest request =
            new LoginWithCustomIDRequest
            {
                CustomId = customId,
                CreateAccount = true
            };

        PlayFabClientAPI.LoginWithCustomID(
            request,
            OnLoginSuccess,
            OnLoginFailure
        );
    }


    private string GetOrCreateLocalPlayerId()
    {
        const string key =
            "PLAYFAB_LOCAL_PLAYER_ID";

        string existingId =
            PlayerPrefs.GetString(
                key,
                ""
            );

        if (!string.IsNullOrEmpty(existingId))
            return existingId;

        string newId =
            Guid.NewGuid().ToString();

        PlayerPrefs.SetString(
            key,
            newId
        );

        PlayerPrefs.Save();

        return newId;
    }


