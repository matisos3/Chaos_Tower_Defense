    private void SaveLeaderboardScore(
        int highestWave,
        double damageDealt,
        int enemiesKilled)
    {
        highestWave =
            Mathf.Max(
                0,
                highestWave
            );

        enemiesKilled =
            Mathf.Max(
                0,
                enemiesKilled
            );

        if (double.IsNaN(damageDealt) ||
            double.IsInfinity(damageDealt) ||
            damageDealt < 0)
        {
            damageDealt = 0;
        }

        if (!IsLoggedIn ||
            !IsEntityLoggedIn ||
            !PlayFabSettings.staticPlayer.IsEntityLoggedIn())
        {
            pendingLeaderboardSave = true;

            pendingLeaderboardHighestWave =
                highestWave;

            pendingLeaderboardDamage =
                damageDealt;

            pendingLeaderboardEnemiesKilled =
                enemiesKilled;

            return;
        }

        long damageScore =
            (long)Math.Round(
                damageDealt,
                MidpointRounding.AwayFromZero
            );

        PlayFabProgressionGetMyEntry(
            current =>
            {
                if (current == null)
                {
                    UpdateLeaderboardScore(
                        highestWave,
                        damageScore,
                        enemiesKilled
                    );

                    return;
                }

                long oldDamage =
                    (long)Math.Round(
                        current.totalDamage,
                        MidpointRounding.AwayFromZero
                    );

                bool better =
                    IsLeaderboardScoreBetter(
                        highestWave,
                        damageScore,
                        enemiesKilled,
                        current.highestWave,
                        oldDamage,
                        current.enemiesKilled
                    );

                if (better)
                {
                    UpdateLeaderboardScore(
                        highestWave,
                        damageScore,
                        enemiesKilled
                    );
                }
            }
        );
    }

    private bool IsLeaderboardScoreBetter(
        int newWave,
        long newDamage,
        int newKills,
        int oldWave,
        long oldDamage,
        int oldKills)
    {
        if (newWave != oldWave)
            return newWave > oldWave;

        if (newDamage != oldDamage)
            return newDamage > oldDamage;

        return newKills > oldKills;
    }

    private void UpdateLeaderboardScore(
        int highestWave,
        long damageScore,
        int enemiesKilled)
    {
        if (!IsLoggedIn ||
            !IsEntityLoggedIn)
        {
            pendingLeaderboardSave = true;

            pendingLeaderboardHighestWave =
                highestWave;

            pendingLeaderboardDamage =
                damageScore;

            pendingLeaderboardEnemiesKilled =
                enemiesKilled;

            return;
        }

        string displayName =
            string.IsNullOrWhiteSpace(PlayerDisplayName)
                ? "Gracz"
                : PlayerDisplayName;

        List<ProgressionModels.LeaderboardEntryUpdate>
            entries =
            new List<
                ProgressionModels.LeaderboardEntryUpdate>
            {
                new ProgressionModels.LeaderboardEntryUpdate
                {
                    EntityId =
                        PlayFabId,

                    Metadata =
                        displayName,

                    Scores =
                        new List<string>
                        {
                            highestWave.ToString(
                                CultureInfo.InvariantCulture
                            ),

                            damageScore.ToString(
                                CultureInfo.InvariantCulture
                            ),

                            enemiesKilled.ToString(
                                CultureInfo.InvariantCulture
                            )
                        }
                }
            };

        PlayFabProgressionAPI.UpdateLeaderboardEntries(
            new ProgressionModels.UpdateLeaderboardEntriesRequest
            {
                LeaderboardName =
                    leaderboardName,

                Entries =
                    entries
            },
            result =>
            {
                Debug.Log(
                    "[PlayFabManager] Leaderboard zapisany."
                );
            },
            error =>
            {
                Debug.LogWarning(
                    "[PlayFabManager] Leaderboard nie zapisany: " +
                    GetPlayFabErrorText(error)
                );

                pendingLeaderboardSave = true;

                pendingLeaderboardHighestWave =
                    highestWave;

                pendingLeaderboardDamage =
                    damageScore;

                pendingLeaderboardEnemiesKilled =
                    enemiesKilled;
            }
        );
    }

