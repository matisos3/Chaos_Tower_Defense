    private void PlayFabProgressionGetMyEntry(
        Action<bool, LeaderboardEntryData> callback)
    {
        if (!IsLoggedIn)
        {
            callback?.Invoke(
                false,
                null
            );

            return;
        }

        if (!IsEntityLoggedIn ||
            PlayFabSettings.staticPlayer == null ||
            !PlayFabSettings.staticPlayer.IsEntityLoggedIn())
        {
            callback?.Invoke(
                false,
                null
            );

            return;
        }

        if (string.IsNullOrEmpty(
            PlayFabId))
        {
            callback?.Invoke(
                false,
                null
            );

            return;
        }

        ProgressionModels.GetLeaderboardForEntitiesRequest
            request =
            new ProgressionModels
                .GetLeaderboardForEntitiesRequest
            {
                LeaderboardName =
                    leaderboardName,

                EntityIds =
                    new List<string>
                    {
                        PlayFabId
                    }
            };

        PlayFabProgressionAPI.GetLeaderboardForEntities(
            request,
            result =>
            {
                if (result == null ||
                    result.Rankings == null ||
                    result.Rankings.Count == 0)
                {
                    callback?.Invoke(
                        true,
                        null
                    );

                    return;
                }

                ProgressionModels.EntityLeaderboardEntry
