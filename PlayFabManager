    // =========================================================
    // GAME OVER
    // =========================================================

    public void SaveGameOverStats(
        int enemiesKilled,
        double damageDealt,
        int highestWave,
        int goldEarned,
        int gameDuration,
        int skillsPurchased,
        int upgradesPurchased,
        Action<bool> callback = null)
    {
        enemiesKilled =
            Mathf.Max(
                0,
                enemiesKilled
            );

        highestWave =
            Mathf.Max(
                0,
                highestWave
            );

        goldEarned =
            Mathf.Max(
                0,
                goldEarned
            );

        gameDuration =
            Mathf.Max(
                0,
                gameDuration
            );

        skillsPurchased =
            Mathf.Max(
                0,
                skillsPurchased
            );

        upgradesPurchased =
            Mathf.Max(
                0,
                upgradesPurchased
            );

        if (double.IsNaN(damageDealt) ||
            double.IsInfinity(damageDealt) ||
            damageDealt < 0)
        {
            damageDealt = 0;
        }

        string buildSkills = "";

        string buildUpgrades = "";

        string buildSummary = "";

        if (GameStatsManager.Instance != null)
        {
            buildSkills =
                GameStatsManager.Instance
                    .GetPurchasedSkillsSummary();

            buildUpgrades =
                GameStatsManager.Instance
                    .GetPurchasedUpgradesSummary();

            buildSummary =
                GameStatsManager.Instance
                    .GetBuildSummary();
        }

        // -----------------------------------------------------
        // TEN SAM GAME OVER ZOSTAŁ JUŻ W PEŁNI ZAPISANY
        // -----------------------------------------------------

        if (gameOverSaveCompleted)
        {
            bool same =
                IsSameGameOver(
                    enemiesKilled,
                    damageDealt,
                    highestWave,
                    goldEarned,
                    gameDuration,
                    skillsPurchased,
                    upgradesPurchased
                );

            if (same)
            {
                callback?.Invoke(true);
                return;
            }

            ResetGameOverSaveState();
        }

        // -----------------------------------------------------
        // NOWY GAME OVER
        // -----------------------------------------------------

        if (!HasGameOverData())
        {
            gameOverEnemiesKilled =
                enemiesKilled;

            gameOverDamageDealt =
                damageDealt;

            gameOverHighestWave =
                highestWave;

            gameOverGoldEarned =
                goldEarned;

            gameOverGameDuration =
                gameDuration;

            gameOverSkillsPurchased =
                skillsPurchased;

            gameOverUpgradesPurchased =
                upgradesPurchased;

            gameOverBuildSkills =
                buildSkills ?? "";

            gameOverBuildUpgrades =
                buildUpgrades ?? "";

            gameOverBuildSummary =
                buildSummary ?? "";
        }
        else
        {
            /*
             * Przy ponowieniu próby GameOverUI przekazuje
             * te same dane.
             *
             * Nie nadpisujemy stanu zapisu.
             */
            bool same =
                IsSameGameOver(
                    enemiesKilled,
                    damageDealt,
                    highestWave,
                    goldEarned,
                    gameDuration,
                    skillsPurchased,
                    upgradesPurchased
                );

            if (!same)
            {
                /*
                 * Inny Game Over = nowa sesja danych.
                 */
                ResetGameOverSaveState();

                gameOverEnemiesKilled =
                    enemiesKilled;

                gameOverDamageDealt =
                    damageDealt;

                gameOverHighestWave =
                    highestWave;

                gameOverGoldEarned =
                    goldEarned;

                gameOverGameDuration =
                    gameDuration;

                gameOverSkillsPurchased =
                    skillsPurchased;

                gameOverUpgradesPurchased =
                    upgradesPurchased;

                gameOverBuildSkills =
                    buildSkills ?? "";

                gameOverBuildUpgrades =
                    buildUpgrades ?? "";

                gameOverBuildSummary =
                    buildSummary ?? "";
            }
        }

        if (!IsLoggedIn)
        {
            callback?.Invoke(false);
            return;
        }

        if (gameOverSaveInProgress)
            return;

        gameOverSaveInProgress = true;

        /*
         * Najpierw próbujemy zapisać brakujące UserData.
         *
         * Następnie brakujące Statistics.
         *
         * Oba zapisy są niezależne.
         */
        SaveMissingGameOverParts(
            callback
        );
    }

    private bool HasGameOverData()
    {
        return
            gameOverEnemiesKilled > 0 ||
            gameOverDamageDealt > 0 ||
            gameOverHighestWave > 0 ||
            gameOverGoldEarned > 0 ||
            gameOverGameDuration > 0 ||
            gameOverSkillsPurchased > 0 ||
            gameOverUpgradesPurchased > 0 ||
            !string.IsNullOrEmpty(
                gameOverBuildSkills
            ) ||
            !string.IsNullOrEmpty(
                gameOverBuildUpgrades
            ) ||
            !string.IsNullOrEmpty(
                gameOverBuildSummary
            );
    }

    private bool IsSameGameOver(
        int enemiesKilled,
        double damageDealt,
        int highestWave,
        int goldEarned,
        int gameDuration,
        int skillsPurchased,
        int upgradesPurchased)
    {
        return
            gameOverEnemiesKilled ==
                enemiesKilled &&

            Math.Abs(
                gameOverDamageDealt -
                damageDealt
            ) < 0.000001 &&

            gameOverHighestWave ==
                highestWave &&

            gameOverGoldEarned ==
                goldEarned &&

            gameOverGameDuration ==
                gameDuration &&

            gameOverSkillsPurchased ==
                skillsPurchased &&

            gameOverUpgradesPurchased ==
                upgradesPurchased;
    }

    private void SaveMissingGameOverParts(
        Action<bool> callback)
    {
        if (!IsLoggedIn)
        {
            gameOverSaveInProgress = false;

            callback?.Invoke(false);

            return;
        }

        /*
         * Jeżeli oba elementy są już zapisane,
         * Game Over jest gotowy.
         */
        if (gameOverStatisticsSaved &&
            gameOverUserDataSaved)
        {
            FinishGameOverSave(
                callback
            );

            return;
        }

        /*
         * Najpierw UserData.
         *
         * Jest niezależne od PlayerStatistics.
         */
        if (!gameOverUserDataSaved)
        {
            SaveGameOverUserData(
                success =>
                {
                    if (!success)
                    {
                        gameOverSaveInProgress = false;

                        callback?.Invoke(false);

                        return;
                    }

                    SaveMissingGameOverStatistics(
                        callback
                    );
                }
            );

            return;
        }

        /*
         * UserData jest już zapisane.
         *
         * Ponawiamy wyłącznie Statistics.
         */
        SaveMissingGameOverStatistics(
            callback
        );
    }

    private void SaveMissingGameOverStatistics(
        Action<bool> callback)
    {
        if (gameOverStatisticsSaved)
        {
            FinishGameOverSave(
                callback
            );

            return;
        }

        UpdateGameOverStatistics(
            success =>
            {
                if (!success)
                {
                    gameOverSaveInProgress = false;

                    callback?.Invoke(false);

                    return;
                }

                gameOverStatisticsSaved = true;

                FinishGameOverSave(
                    callback
                );
            }
        );
    }

    private void FinishGameOverSave(
        Action<bool> callback)
    {
        gameOverSaveInProgress = false;

        gameOverSaveCompleted =
            gameOverStatisticsSaved &&
            gameOverUserDataSaved;

        if (gameOverSaveCompleted)
        {
            SaveLeaderboardScore(
                gameOverHighestWave,
                gameOverDamageDealt,
                gameOverEnemiesKilled
            );

            callback?.Invoke(true);

            TryFlushPendingData();

            return;
        }

        callback?.Invoke(false);
    }

    private void ResetGameOverSaveState()
    {
        gameOverSaveInProgress = false;

        gameOverStatisticsSaved = false;

        gameOverUserDataSaved = false;

        gameOverSaveCompleted = false;

        gameOverEnemiesKilled = 0;

        gameOverDamageDealt = 0;

        gameOverHighestWave = 0;

        gameOverGoldEarned = 0;

        gameOverGameDuration = 0;

        gameOverSkillsPurchased = 0;

        gameOverUpgradesPurchased = 0;

        gameOverBuildSkills = "";

        gameOverBuildUpgrades = "";

        gameOverBuildSummary = "";
    }

    // =========================================================
    // FLUSH
    // =========================================================

    private void TryFlushPendingData()
    {
        if (!IsLoggedIn)
            return;

        if (gameOverSaveInProgress)
            return;

        /*
         * XP jest niezależne od Game Over.
         */
        if (pendingXP > 0.0)
        {
            FlushXP(null);
        }
    }

    // =========================================================
    // UPDATE STATISTICS
    // =========================================================

    private void UpdateGameOverStatistics(
        Action<bool> callback)
    {
        if (!IsLoggedIn)
        {
            callback?.Invoke(false);
            return;
        }

        /*
         * Pobieramy aktualne wartości statystyk,
         * aby zachować dane z poprzednich gier.
         */
        PlayFabClientAPI.GetPlayerStatistics(
            new GetPlayerStatisticsRequest(),
            result =>
            {
                int highestWave = 0;

                int gamesPlayed = 0;

                int totalEnemiesKilled = 0;

                int totalGoldEarned = 0;

                int totalGameTime = 0;

                int totalSkillsPurchased = 0;

                int totalUpgradesPurchased = 0;

                if (result != null &&
                    result.Statistics != null)
                {
                    foreach (
                        StatisticValue stat
                        in result.Statistics)
                    {
                        if (stat == null)
                            continue;

                        switch (stat.StatisticName)
                        {
                            case "HighestWave":

                                highestWave =
                                    Mathf.Max(
                                        0,
                                        stat.Value
                                    );

                                break;

                            case "GamesPlayed":

                                gamesPlayed =
                                    Mathf.Max(
                                        0,
                                        stat.Value
                                    );

                                break;

                            case "TotalEnemiesKilled":

                                totalEnemiesKilled =
                                    Mathf.Max(
                                        0,
                                        stat.Value
                                    );

                                break;

                            case "TotalGoldEarned":

                                totalGoldEarned =
                                    Mathf.Max(
                                        0,
                                        stat.Value
                                    );

                                break;

                            case "TotalGameTime":

                                totalGameTime =
                                    Mathf.Max(
                                        0,
                                        stat.Value
                                    );

                                break;

                            case "TotalSkillsPurchased":

                                totalSkillsPurchased =
                                    Mathf.Max(
                                        0,
                                        stat.Value
                                    );

                                break;

                            case "TotalUpgradesPurchased":

                                totalUpgradesPurchased =
                                    Mathf.Max(
                                        0,
                                        stat.Value
                                    );

                                break;
                        }
                    }
                }

                int newHighestWave =
                    Mathf.Max(
                        highestWave,
                        gameOverHighestWave
                    );

                List<StatisticUpdate> updates =
                    new List<StatisticUpdate>
                    {
                        new StatisticUpdate
                        {
                            StatisticName =
                                "EnemiesKilled",

                            Value =
                                gameOverEnemiesKilled
                        },

                        new StatisticUpdate
                        {
                            StatisticName =
                                "HighestWave",

                            Value =
                                newHighestWave
                        },

                        new StatisticUpdate
                        {
                            StatisticName =
                                "GoldEarned",

                            Value =
                                gameOverGoldEarned
                        },

                        new StatisticUpdate
                        {
                            StatisticName =
                                "GameDuration",

                            Value =
                                gameOverGameDuration
                        },

                        new StatisticUpdate
                        {
                            StatisticName =
                                "GamesPlayed",

                            Value =
                                gamesPlayed + 1
                        },

                        new StatisticUpdate
                        {
                            StatisticName =
                                "TotalEnemiesKilled",

                            Value =
                                totalEnemiesKilled +
                                gameOverEnemiesKilled
                        },

                        new StatisticUpdate
                        {
                            StatisticName =
                                "TotalGoldEarned",

                            Value =
                                totalGoldEarned +
                                gameOverGoldEarned
                        },

                        new StatisticUpdate
                        {
                            StatisticName =
                                "TotalGameTime",

                            Value =
                                totalGameTime +
                                gameOverGameDuration
                        },

                        new StatisticUpdate
                        {
                            StatisticName =
                                "TotalSkillsPurchased",

                            Value =
                                totalSkillsPurchased +
                                gameOverSkillsPurchased
                        },

                        new StatisticUpdate
                        {
                            StatisticName =
                                "TotalUpgradesPurchased",

                            Value =
                                totalUpgradesPurchased +
                                gameOverUpgradesPurchased
                        }
                    };

                PlayFabClientAPI.UpdatePlayerStatistics(
                    new UpdatePlayerStatisticsRequest
                    {
                        Statistics =
                            updates
                    },
                    updateResult =>
                    {
                        callback?.Invoke(true);
                    },
                    error =>
                    {
                        callback?.Invoke(false);
                    }
                );
            },
            error =>
            {
                callback?.Invoke(false);
            }
        );
    }

