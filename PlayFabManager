    public void SaveGameOverStats(
        int enemiesKilled,
        double damageDealt,
        int highestWave,
        int goldEarned,
        int gameDuration,
        int skillsPurchased,
        int upgradesPurchased,
        Action<bool> callback = null)
    {
        enemiesKilled =
            Mathf.Max(
                0,
                enemiesKilled
            );

        if (double.IsNaN(damageDealt) ||
            double.IsInfinity(damageDealt) ||
            damageDealt < 0.0)
        {
            damageDealt = 0.0;
        }

        highestWave =
            Mathf.Max(
                0,
                highestWave
            );

        goldEarned =
            Mathf.Max(
                0,
                goldEarned
            );

        gameDuration =
            Mathf.Max(
                0,
                gameDuration
            );

        skillsPurchased =
            Mathf.Max(
                0,
                skillsPurchased
            );

        upgradesPurchased =
            Mathf.Max(
                0,
                upgradesPurchased
            );

        if (gameOverStatsSaved)
        {
            gameOverStatsSaved = false;
        }

        string buildSkills = "";
        string buildUpgrades = "";
        string buildSummary = "";

        if (GameStatsManager.Instance != null)
        {
            buildSkills =
                GameStatsManager.Instance
                    .GetPurchasedSkillsSummary();

            buildUpgrades =
                GameStatsManager.Instance
                    .GetPurchasedUpgradesSummary();

            buildSummary =
                GameStatsManager.Instance
                    .GetBuildSummary();
        }

        /*
         * ZAWSZE najpierw zapisujemy lokalny pending.
         *
         * Nawet gdy jesteśmy zalogowani.
         *
         * Dzięki temu jeżeli aplikacja zostanie zabita
         * dokładnie podczas requestu PlayFab,
         * dane nadal istnieją.
         */
        SetPendingGameOverStats(
            enemiesKilled,
            damageDealt,
            highestWave,
            goldEarned,
            gameDuration,
            skillsPurchased,
            upgradesPurchased,
            buildSkills,
            buildUpgrades,
            buildSummary,
            callback
        );

        if (!IsLoggedIn)
        {
            Debug.LogWarning(
                "[PlayFabManager] Gracz nie jest zalogowany. " +
                "Game Over zapisany lokalnie i zostanie ponowiony."
            );

            return;
        }

        SavePendingGameOverStats();
    }


    private void SavePendingGameOverStats()
    {
        if (!pendingGameOverStats)
            return;

        if (!IsLoggedIn)
            return;

        if (gameOverSaveInProgress)
            return;

        gameOverSaveInProgress = true;

        SendGameOverStats(
            pendingEnemiesKilled,
            pendingDamageDealt,
            pendingHighestWave,
            pendingGoldEarned,
            pendingGameDuration,
            pendingSkillsPurchased,
            pendingUpgradesPurchased,
            pendingBuildSkills,
            pendingBuildUpgrades,
            pendingBuildSummary,
            success =>
            {
                gameOverSaveInProgress = false;

                if (!success)
                {
                    /*
                     * NIE kasujemy pending.
                     *
                     * Pozostaje w RAM + PlayerPrefs.
                     */
                    SavePendingGameOverToPlayerPrefs();

                    Debug.LogWarning(
                        "[PlayFabManager] Game Over nie został " +
                        "zapisany. Dane pozostają oczekujące."
                    );

                    return;
                }

                /*
                 * Dopiero po pełnym sukcesie usuwamy pending.
                 */
                Action<bool> originalCallback =
                    pendingGameOverStatsCallback;

                ClearPendingGameOverStats();

                gameOverStatsSaved = true;

                originalCallback?.Invoke(true);
            }
        );
    }


    private void SendGameOverStats(
        int enemiesKilled,
        double damageDealt,
        int highestWave,
        int goldEarned,
        int gameDuration,
        int skillsPurchased,
        int upgradesPurchased,
        string buildSkills,
        string buildUpgrades,
        string buildSummary,
        Action<bool> callback = null)
    {
        if (!IsLoggedIn)
        {
            callback?.Invoke(false);
            return;
        }

        PlayFabClientAPI.GetPlayerStatistics(
            new GetPlayerStatisticsRequest(),
            result =>
            {
                int previousHighestWave = 0;
                int previousGamesPlayed = 0;
                int previousTotalEnemiesKilled = 0;
                int previousTotalGoldEarned = 0;
                int previousTotalGameTime = 0;
                int previousTotalSkillsPurchased = 0;
                int previousTotalUpgradesPurchased = 0;

                if (result != null &&
                    result.Statistics != null)
                {
                    foreach (
                        StatisticValue statistic
                        in result.Statistics)
                    {
                        if (statistic == null)
                            continue;

                        switch (
                            statistic.StatisticName)
                        {
                            case "HighestWave":
                                previousHighestWave =
                                    Mathf.Max(
                                        0,
                                        statistic.Value
                                    );
                                break;

                            case "GamesPlayed":
                                previousGamesPlayed =
                                    Mathf.Max(
                                        0,
                                        statistic.Value
                                    );
                                break;

                            case "TotalEnemiesKilled":
                                previousTotalEnemiesKilled =
                                    Mathf.Max(
                                        0,
                                        statistic.Value
                                    );
                                break;

                            case "TotalGoldEarned":
                                previousTotalGoldEarned =
                                    Mathf.Max(
                                        0,
                                        statistic.Value
                                    );
                                break;

                            case "TotalGameTime":
                                previousTotalGameTime =
                                    Mathf.Max(
                                        0,
                                        statistic.Value
                                    );
                                break;

                            case "TotalSkillsPurchased":
                                previousTotalSkillsPurchased =
                                    Mathf.Max(
                                        0,
                                        statistic.Value
                                    );
                                break;

                            case "TotalUpgradesPurchased":
                                previousTotalUpgradesPurchased =
                                    Mathf.Max(
                                        0,
                                        statistic.Value
                                    );
                                break;
                        }
                    }
                }

                int newHighestWave =
                    Mathf.Max(
                        previousHighestWave,
                        highestWave
                    );

                int newGamesPlayed =
                    previousGamesPlayed + 1;

                int newTotalEnemiesKilled =
                    previousTotalEnemiesKilled +
                    enemiesKilled;

                int newTotalGoldEarned =
                    previousTotalGoldEarned +
                    goldEarned;

                int newTotalGameTime =
                    previousTotalGameTime +
                    gameDuration;

                int newTotalSkillsPurchased =
                    previousTotalSkillsPurchased +
                    skillsPurchased;

                int newTotalUpgradesPurchased =
                    previousTotalUpgradesPurchased +
                    upgradesPurchased;

                List<PlayFab.ClientModels.StatisticUpdate>
                    statistics =
                    new List<
                        PlayFab.ClientModels.StatisticUpdate>
                    {
                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "EnemiesKilled",

                            Value =
                                enemiesKilled
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "HighestWave",

                            Value =
                                newHighestWave
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "GoldEarned",

                            Value =
                                goldEarned
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "GameDuration",

                            Value =
                                gameDuration
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "GamesPlayed",

                            Value =
                                newGamesPlayed
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "TotalEnemiesKilled",

                            Value =
                                newTotalEnemiesKilled
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "TotalGoldEarned",

                            Value =
                                newTotalGoldEarned
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "TotalGameTime",

                            Value =
                                newTotalGameTime
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "TotalSkillsPurchased",

                            Value =
                                newTotalSkillsPurchased
                        },

                        new PlayFab.ClientModels.StatisticUpdate
                        {
                            StatisticName =
                                "TotalUpgradesPurchased",

                            Value =
                                newTotalUpgradesPurchased
                        }
                    };

                bool isNewHighestWave =
                    highestWave >
                    previousHighestWave;

                Debug.Log(
                    "[PlayFabManager] Zapisywanie Game Over. " +
                    "Wave=" +
                    highestWave +
                    ", Kills=" +
                    enemiesKilled +
                    ", Damage=" +
                    damageDealt +
                    ", Gold=" +
                    goldEarned +
                    ", Duration=" +
                    gameDuration
                );

                PlayFabClientAPI.UpdatePlayerStatistics(
                    new UpdatePlayerStatisticsRequest
                    {
                        Statistics =
                            statistics
                    },
                    updateResult =>
                    {
                        Debug.Log(
                            "[PlayFabManager] PlayerStatistics " +
                            "Game Over zapisane."
                        );

                        Action<bool> finishSave =
                            success =>
                            {
                                if (!success)
                                {
                                    callback?.Invoke(false);
                                    return;
                                }

                                /*
                                 * Tutaj NIE czyścimy pending.
                                 *
                                 * Pending jest czyszczony dopiero
                                 * przez SavePendingGameOverStats()
                                 * po otrzymaniu success=true.
                                 */

                                SaveLeaderboardScore(
                                    highestWave,
                                    damageDealt,
                                    enemiesKilled
                                );

                                callback?.Invoke(true);
                            };

                        if (isNewHighestWave)
                        {
                            SaveGameBuildData(
                                damageDealt,
                                buildSkills,
                                buildUpgrades,
                                buildSummary,
                                finishSave
                            );
                        }
                        else
                        {
                            SaveDamageDealt(
                                damageDealt,
                                finishSave
                            );
                        }
                    },
                    error =>
                    {
                        Debug.LogError(
                            "[PlayFabManager] Nie udało się zapisać " +
                            "PlayerStatistics Game Over: " +
                            GetPlayFabErrorText(error)
                        );

                        callback?.Invoke(false);
                    }
                );
            },
            error =>
            {
                Debug.LogError(
                    "[PlayFabManager] Nie udało się pobrać " +
                    "PlayerStatistics przed Game Over: " +
                    GetPlayFabErrorText(error)
                );

                callback?.Invoke(false);
            }
        );
    }


