    private void SaveLeaderboardScore(
        int highestWave,
        double damageDealt,
        int enemiesKilled)
    {
        SetPendingLeaderboardSave(
            highestWave,
            damageDealt,
            enemiesKilled
        );

        if (IsLoggedIn &&
            IsEntityLoggedIn &&
            PlayFabSettings.staticPlayer != null &&
            PlayFabSettings.staticPlayer.IsEntityLoggedIn())
        {
            TryProcessPendingLeaderboardSave();
        }
    }


    private void ProcessLeaderboardSave(
        int highestWave,
        double damageDealt,
        int enemiesKilled)
    {
        if (!IsLoggedIn)
        {
            leaderboardSaveInProgress = false;
            return;
        }

        if (!IsEntityLoggedIn ||
            PlayFabSettings.staticPlayer == null ||
            !PlayFabSettings.staticPlayer.IsEntityLoggedIn())
        {
            leaderboardSaveInProgress = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(
            leaderboardName))
        {
            Debug.LogError(
                "[PlayFabManager] Nazwa leaderboardu jest pusta."
            );

            leaderboardSaveInProgress = false;
            return;
        }

        if (string.IsNullOrEmpty(
            PlayFabId))
        {
            Debug.LogError(
                "[PlayFabManager] Brak PlayFabId - " +
                "nie można zapisać leaderboardu."
            );

            leaderboardSaveInProgress = false;
            return;
        }

        highestWave =
            Mathf.Max(
                0,
                highestWave
            );

        enemiesKilled =
            Mathf.Max(
                0,
                enemiesKilled
            );

        if (double.IsNaN(damageDealt) ||
            double.IsInfinity(damageDealt) ||
            damageDealt < 0.0)
        {
            damageDealt = 0.0;
        }

        long damageScore =
            (long)Math.Round(
                damageDealt,
                MidpointRounding.AwayFromZero
            );

        PlayFabProgressionGetMyEntry(
            (success, currentEntry) =>
            {
                if (!success)
                {
                    Debug.LogWarning(
                        "[PlayFabManager] Nie udało się sprawdzić " +
                        "obecnego wyniku leaderboardu. " +
                        "Zapis zostanie ponowiony."
                    );

                    leaderboardSaveInProgress = false;

                    StartLeaderboardRetryCoroutine();

                    return;
                }

                if (currentEntry == null)
                {
                    UpdateLeaderboardScore(
                        highestWave,
                        damageScore,
                        enemiesKilled,
                        success =>
                        {
                            leaderboardSaveInProgress = false;

                            if (!success)
                            {
                                StartLeaderboardRetryCoroutine();
                                return;
                            }

                            if (PendingLeaderboardMatches(
                                highestWave,
                                damageScore,
                                enemiesKilled))
                            {
                                ClearPendingLeaderboardSave();
                            }
                            else
                            {
                                SavePendingLeaderboardToPlayerPrefs();
                            }
                        }
                    );

                    return;
                }

                int oldWave =
                    currentEntry.highestWave;

                long oldDamage =
                    (long)Math.Round(
                        currentEntry.totalDamage,
                        MidpointRounding.AwayFromZero
                    );

                int oldKills =
                    currentEntry.enemiesKilled;

                bool newScoreIsBetter =
                    IsLeaderboardScoreBetter(
                        highestWave,
                        damageScore,
                        enemiesKilled,
                        oldWave,
                        oldDamage,
                        oldKills
                    );

                if (!newScoreIsBetter)
                {
                    leaderboardSaveInProgress = false;

                    if (PendingLeaderboardMatches(
                        highestWave,
                        damageScore,
                        enemiesKilled))
                    {
                        ClearPendingLeaderboardSave();
                    }
                    else
                    {
                        SavePendingLeaderboardToPlayerPrefs();
                    }

                    Debug.Log(
                        "[PlayFabManager] PlayFab posiada już " +
                        "wynik równy lub lepszy od oczekującego."
                    );

                    return;
                }

                UpdateLeaderboardScore(
                    highestWave,
                    damageScore,
                    enemiesKilled,
                    success =>
                    {
                        leaderboardSaveInProgress = false;

                        if (!success)
                        {
                            StartLeaderboardRetryCoroutine();
                            return;
                        }

                        if (PendingLeaderboardMatches(
                            highestWave,
                            damageScore,
                            enemiesKilled))
                        {
                            ClearPendingLeaderboardSave();
                        }
                        else
                        {
                            SavePendingLeaderboardToPlayerPrefs();
                        }
                    }
                );
            }
        );
    }


    private bool PendingLeaderboardMatches(
        int highestWave,
        long damageScore,
        int enemiesKilled)
    {
        if (!pendingLeaderboardSave)
            return false;

        long pendingDamage =
            (long)Math.Round(
                pendingLeaderboardDamage,
                MidpointRounding.AwayFromZero
            );

        return
            pendingLeaderboardHighestWave ==
                highestWave &&
            pendingDamage ==
                damageScore &&
            pendingLeaderboardEnemiesKilled ==
                enemiesKilled;
    }


    private bool IsLeaderboardScoreBetter(
        int newWave,
        double newDamage,
        int newKills,
        int oldWave,
        double oldDamage,
        int oldKills)
    {
        if (newWave > oldWave)
            return true;

        if (newWave < oldWave)
            return false;

        if (newDamage > oldDamage)
            return true;

        if (newDamage < oldDamage)
            return false;

        if (newKills > oldKills)
            return true;

        return false;
    }


    // =========================================================
    // UPDATE LEADERBOARD
    // =========================================================

    private void UpdateLeaderboardScore(
        int highestWave,
        long damageScore,
        int enemiesKilled,
        Action<bool> callback = null)
    {
        if (!IsLoggedIn)
        {
            callback?.Invoke(false);
            return;
        }

        if (!IsEntityLoggedIn ||
            PlayFabSettings.staticPlayer == null ||
            !PlayFabSettings.staticPlayer.IsEntityLoggedIn())
        {
            callback?.Invoke(false);
            return;
        }

        string leaderboardDisplayName =
            PlayerDisplayName;

        if (string.IsNullOrWhiteSpace(
            leaderboardDisplayName))
        {
            leaderboardDisplayName =
                "Gracz";
        }

        List<ProgressionModels.LeaderboardEntryUpdate>
            entries =
            new List<
                ProgressionModels.LeaderboardEntryUpdate>
            {
                new ProgressionModels.LeaderboardEntryUpdate
                {
                    EntityId =
                        PlayFabId,

                    Metadata =
                        leaderboardDisplayName,

                    Scores =
                        new List<string>
                        {
                            highestWave.ToString(
                                CultureInfo.InvariantCulture
                            ),

                            damageScore.ToString(
                                CultureInfo.InvariantCulture
                            ),

                            enemiesKilled.ToString(
                                CultureInfo.InvariantCulture
                            )
                        }
                }
            };

        ProgressionModels.UpdateLeaderboardEntriesRequest
            request =
            new ProgressionModels
                .UpdateLeaderboardEntriesRequest
            {
                LeaderboardName =
                    leaderboardName,

                Entries =
                    entries
            };

        PlayFabProgressionAPI.UpdateLeaderboardEntries(
            request,
            result =>
            {
                Debug.Log(
                    "[PlayFabManager] Wynik leaderboardu zapisany. " +
                    "Wave: " +
                    highestWave +
                    ", Damage: " +
                    damageScore +
                    ", Kills: " +
                    enemiesKilled +
                    ", Nazwa: " +
                    leaderboardDisplayName
                );

                callback?.Invoke(true);
            },
            error =>
            {
                Debug.LogError(
                    "[PlayFabManager] Nie udało się zapisać " +
                    "leaderboardu: " +
                    GetPlayFabErrorText(error)
                );

                callback?.Invoke(false);
            }
        );
    }


    // =========================================================
