    // =========================================================

    private void GetEntityToken()
    {
        if (!IsLoggedIn)
            return;

        authenticationAPI =
            new PlayFabAuthenticationInstanceAPI(
                PlayFabSettings.staticPlayer
            );

        authenticationAPI.GetEntityToken(
            new GetEntityTokenRequest(),
            OnEntityTokenReceived,
            OnEntityTokenFailed
        );
    }

    private void OnEntityTokenReceived(
        GetEntityTokenResponse result)
    {
        if (result == null ||
            result.Entity == null ||
            string.IsNullOrEmpty(result.EntityToken))
        {
            OnEntityTokenFailed(
                new PlayFabError
                {
                    ErrorMessage =
                        "Brak Entity Token."
                }
            );

            return;
        }

        EntityToken =
            result.EntityToken;

        EntityId =
            result.Entity.Id;

        EntityType =
            result.Entity.Type;

        PlayFabSettings.staticPlayer.EntityToken =
            EntityToken;

        PlayFabSettings.staticPlayer.EntityId =
            EntityId;

        PlayFabSettings.staticPlayer.EntityType =
            EntityType;

        IsEntityLoggedIn =
            PlayFabSettings.staticPlayer.IsEntityLoggedIn();

        Debug.Log(
            "[PlayFabManager] Entity Token OK."
        );

        if (pendingLeaderboardSave)
        {
            int wave =
                pendingLeaderboardHighestWave;

            double damage =
                pendingLeaderboardDamage;

            int kills =
                pendingLeaderboardEnemiesKilled;

            pendingLeaderboardSave = false;

            SaveLeaderboardScore(
                wave,
                damage,
                kills
            );
        }

        TryFlushPendingData();
    }

    private void OnEntityTokenFailed(
        PlayFabError error)
    {
        IsEntityLoggedIn = false;

        EntityToken = "";
        EntityId = "";
        EntityType = "";

        Debug.LogWarning(
            "[PlayFabManager] Entity Token niedostępny: " +
            GetPlayFabErrorText(error)
        );
    }

